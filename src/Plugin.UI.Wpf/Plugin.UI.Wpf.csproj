<Project Sdk="Microsoft.NET.Sdk">

  <!-- 共通の画面の拡張（WPF）の契約（指示書 7.1 の Plugin.UI）。ドッキングパネルと、アプリの窓に合わせた知らせ。
       Plugin.Core と同じく、アプリと全プラグインで 1 つだけ読み込む -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Plugin.UI.Wpf</RootNamespace>
    <AssemblyName>Plugin.UI.Wpf</AssemblyName>
    <Version>1.0.0</Version>
    <!-- プラグインを作る人のための説明（XML の API 文書）。DLL と一緒にアプリの出力へ写り、Visual Studio の候補の説明に出る -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Plugin.Core\Plugin.Core.csproj" />
  </ItemGroup>

</Project>
