<Application x:Class="Theater3D.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <!-- Phase 0 の仮の配色。Phase 1 で正式なダークテーマにまとめる -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FF1B1C1F" />
    <SolidColorBrush x:Key="PanelHeaderBrush" Color="#FF2A2C31" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#FF3A3C42" />
    <SolidColorBrush x:Key="StatusBarBrush" Color="#FF202124" />
    <SolidColorBrush x:Key="TextBrush" Color="#FFE3E4E8" />
    <SolidColorBrush x:Key="SubTextBrush" Color="#FF9A9DA6" />
    <SolidColorBrush x:Key="OverlayBrush" Color="#CC2563EB" />
  </Application.Resources>
</Application>
