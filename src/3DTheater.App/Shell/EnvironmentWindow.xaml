<Window x:Class="Theater3D.App.Shell.EnvironmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="環境の画像"
        Width="500" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Yu Gothic UI" FontSize="12" UseLayoutRounding="True">
  <Window.Resources>
    <Style x:Key="RowLabelStyle" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="22,0,12,0" />
      <Setter Property="Foreground" Value="{StaticResource SubTextBrush}" />
    </Style>
    <Style x:Key="ValueStyle" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="Margin" Value="8,0,0,0" />
    </Style>
    <Style x:Key="EnvironmentSliderStyle" TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,5" />
      <Setter Property="IsMoveToPointEnabled" Value="True" />
    </Style>
  </Window.Resources>

  <StackPanel Margin="18,6,18,16">
    <CheckBox x:Name="EnabledCheck" Margin="0,10,0,4" FontWeight="SemiBold" Content="環境の画像を使う（PBR の材質の環境光と映り込み）"
              Checked="OnCheckChanged" Unchecked="OnCheckChanged" />
    <!-- ファイルは、使う前でも選べる（選ぶと使う） -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="110" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock Style="{StaticResource RowLabelStyle}" Text="ファイル" />
      <DockPanel Grid.Column="1" Margin="0,5">
        <Button DockPanel.Dock="Right" MinWidth="72" Margin="8,0,0,0" Content="参照..." Click="OnBrowseClick"
                ToolTip="Radiance HDR（.hdr）の画像を選びます（全方向の景色を、横 360 度・縦 180 度に広げた画像）" />
        <TextBox x:Name="FileBox" IsReadOnly="True" VerticalContentAlignment="Center" AutomationProperties.Name="環境の画像のファイル" />
      </DockPanel>
      <TextBlock x:Name="StatusText" Grid.Row="1" Grid.Column="1" Margin="0,0,0,6" TextWrapping="Wrap"
                 Foreground="{StaticResource SubTextBrush}" FontSize="11.5" />
    </Grid>
    <Grid IsEnabled="{Binding IsChecked, ElementName=EnabledCheck}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="110" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="56" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock Style="{StaticResource RowLabelStyle}" Text="明るさ" />
      <Slider x:Name="IntensitySlider" Grid.Column="1" Style="{StaticResource EnvironmentSliderStyle}" Minimum="0" Maximum="4"
              SmallChange="0.05" LargeChange="0.25" AutomationProperties.Name="環境の画像の明るさ" ValueChanged="OnSliderChanged" />
      <TextBlock x:Name="IntensityText" Grid.Column="2" Style="{StaticResource ValueStyle}" />
      <TextBlock Grid.Row="1" Style="{StaticResource RowLabelStyle}" Text="回転" ToolTip="景色を、真上から見て時計回りに回します（度）" />
      <Slider x:Name="RotationSlider" Grid.Row="1" Grid.Column="1" Style="{StaticResource EnvironmentSliderStyle}" Minimum="-180" Maximum="180"
              SmallChange="1" LargeChange="15" AutomationProperties.Name="環境の画像の回転" ValueChanged="OnSliderChanged" />
      <TextBlock x:Name="RotationText" Grid.Row="1" Grid.Column="2" Style="{StaticResource ValueStyle}" />
      <CheckBox x:Name="BackgroundCheck" Grid.Row="2" Grid.ColumnSpan="3" Margin="22,6,0,4"
                Content="背景に表示する（カメラ視点・自由視点と、色の背景の書き出し）" Checked="OnCheckChanged" Unchecked="OnCheckChanged" />
    </Grid>

    <TextBlock Margin="0,14,0,0" TextWrapping="Wrap" Foreground="{StaticResource SubTextBrush}" FontSize="11.5"
               Text="拡張材質（モデルのメニュー「材質の設定...」）で PBR にした材質が、この景色に照らされ、景色を映します。トゥーンの材質は今までどおり（MMD と同じ見え方）です。正面・側面などの固定の視点と、透明な背景の書き出しには背景を描きません。横が 4096 画素を超える画像は縮めて使います。設定はプロジェクトに保存します（画像はプロジェクトのフォルダーから見た場所でも記録します。変えた分は、まとめて 1 回の「元に戻す」で戻せます）。" />

    <DockPanel Margin="0,16,0,0" LastChildFill="False">
      <Button DockPanel.Dock="Left" MinWidth="110" Content="初期値に戻す" Click="OnResetClick" ToolTip="環境の画像を使わない状態に戻します" />
      <Button DockPanel.Dock="Right" MinWidth="88" Content="閉じる" IsCancel="True" IsDefault="True" Click="OnCloseClick" />
    </DockPanel>
  </StackPanel>
</Window>
