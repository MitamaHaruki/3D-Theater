<Window x:Class="Theater3D.App.Shell.EffectsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="映像効果"
        Width="470" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Yu Gothic UI" FontSize="12" UseLayoutRounding="True">
  <Window.Resources>
    <Style x:Key="GroupCheckStyle" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,12,0,4" />
    </Style>
    <Style x:Key="RowLabelStyle" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="22,0,12,0" />
      <Setter Property="Foreground" Value="{StaticResource SubTextBrush}" />
    </Style>
    <Style x:Key="ValueStyle" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="Margin" Value="8,0,0,0" />
    </Style>
    <Style x:Key="EffectSliderStyle" TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,5" />
      <Setter Property="IsMoveToPointEnabled" Value="True" />
      <Setter Property="SmallChange" Value="0.05" />
      <Setter Property="LargeChange" Value="0.1" />
    </Style>
  </Window.Resources>

  <StackPanel Margin="18,4,18,16">
    <!-- 色調補正 -->
    <CheckBox x:Name="ColorCheck" Style="{StaticResource GroupCheckStyle}" Content="色調補正" Checked="OnCheckChanged" Unchecked="OnCheckChanged" />
    <Grid IsEnabled="{Binding IsChecked, ElementName=ColorCheck}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="140" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="60" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock Style="{StaticResource RowLabelStyle}" Text="明るさ" ToolTip="段で数えます（+1 で 2 倍、-1 で半分の明るさ）" />
      <Slider x:Name="ExposureSlider" Grid.Column="1" Style="{StaticResource EffectSliderStyle}" Minimum="-3" Maximum="3"
              AutomationProperties.Name="明るさ" ValueChanged="OnSliderChanged" />
      <TextBlock x:Name="ExposureText" Grid.Column="2" Style="{StaticResource ValueStyle}" />
      <TextBlock Grid.Row="1" Style="{StaticResource RowLabelStyle}" Text="コントラスト" ToolTip="1 で変えません。大きいほど明暗の差が強くなります" />
      <Slider x:Name="ContrastSlider" Grid.Row="1" Grid.Column="1" Style="{StaticResource EffectSliderStyle}" Minimum="0" Maximum="2"
              AutomationProperties.Name="コントラスト" ValueChanged="OnSliderChanged" />
      <TextBlock x:Name="ContrastText" Grid.Row="1" Grid.Column="2" Style="{StaticResource ValueStyle}" />
      <TextBlock Grid.Row="2" Style="{StaticResource RowLabelStyle}" Text="彩度" ToolTip="1 で変えません。0 で白黒になります" />
      <Slider x:Name="SaturationSlider" Grid.Row="2" Grid.Column="1" Style="{StaticResource EffectSliderStyle}" Minimum="0" Maximum="2"
              AutomationProperties.Name="彩度" ValueChanged="OnSliderChanged" />
      <TextBlock x:Name="SaturationText" Grid.Row="2" Grid.Column="2" Style="{StaticResource ValueStyle}" />
      <TextBlock Grid.Row="3" Style="{StaticResource RowLabelStyle}" Text="色温度" ToolTip="0 で変えません。マイナスで青く、プラスで黄色くなります" />
      <Slider x:Name="TemperatureSlider" Grid.Row="3" Grid.Column="1" Style="{StaticResource EffectSliderStyle}" Minimum="-1" Maximum="1"
              AutomationProperties.Name="色温度" ValueChanged="OnSliderChanged" />
      <TextBlock x:Name="TemperatureText" Grid.Row="3" Grid.Column="2" Style="{StaticResource ValueStyle}" />
    </Grid>

    <!-- ブルーム -->
    <CheckBox x:Name="BloomCheck" Style="{StaticResource GroupCheckStyle}" Content="ブルーム（明るい所が周りへにじむ光）"
              Checked="OnCheckChanged" Unchecked="OnCheckChanged" />
    <Grid IsEnabled="{Binding IsChecked, ElementName=BloomCheck}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="140" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="60" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock Style="{StaticResource RowLabelStyle}" Text="強さ" />
      <Slider x:Name="BloomIntensitySlider" Grid.Column="1" Style="{StaticResource EffectSliderStyle}" Minimum="0" Maximum="3"
              AutomationProperties.Name="ブルームの強さ" ValueChanged="OnSliderChanged" />
      <TextBlock x:Name="BloomIntensityText" Grid.Column="2" Style="{StaticResource ValueStyle}" />
      <TextBlock Grid.Row="1" Style="{StaticResource RowLabelStyle}" Text="光り始める明るさ" ToolTip="これより明るい所だけが光ります（1 に近いほど、白に近い所だけ）" />
      <Slider x:Name="BloomThresholdSlider" Grid.Row="1" Grid.Column="1" Style="{StaticResource EffectSliderStyle}" Minimum="0" Maximum="1"
              AutomationProperties.Name="光り始める明るさ" ValueChanged="OnSliderChanged" />
      <TextBlock x:Name="BloomThresholdText" Grid.Row="1" Grid.Column="2" Style="{StaticResource ValueStyle}" />
      <TextBlock Grid.Row="2" Style="{StaticResource RowLabelStyle}" Text="広がり" ToolTip="大きいほど、光が遠くまでにじみます" />
      <Slider x:Name="BloomSpreadSlider" Grid.Row="2" Grid.Column="1" Style="{StaticResource EffectSliderStyle}" Minimum="0" Maximum="1"
              AutomationProperties.Name="広がり" ValueChanged="OnSliderChanged" />
      <TextBlock x:Name="BloomSpreadText" Grid.Row="2" Grid.Column="2" Style="{StaticResource ValueStyle}" />
    </Grid>

    <!-- 周辺減光 -->
    <CheckBox x:Name="VignetteCheck" Style="{StaticResource GroupCheckStyle}" Content="周辺減光（画面の四隅を暗くする）"
              Checked="OnCheckChanged" Unchecked="OnCheckChanged" />
    <Grid IsEnabled="{Binding IsChecked, ElementName=VignetteCheck}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="140" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="60" />
      </Grid.ColumnDefinitions>
      <TextBlock Style="{StaticResource RowLabelStyle}" Text="強さ" />
      <Slider x:Name="VignetteSlider" Grid.Column="1" Style="{StaticResource EffectSliderStyle}" Minimum="0" Maximum="1"
              AutomationProperties.Name="周辺減光の強さ" ValueChanged="OnSliderChanged" />
      <TextBlock x:Name="VignetteText" Grid.Column="2" Style="{StaticResource ValueStyle}" />
    </Grid>

    <TextBlock Margin="0,14,0,0" TextWrapping="Wrap" Foreground="{StaticResource SubTextBrush}" FontSize="11.5"
               Text="変えるとすぐにプレビューへ反映し、書き出し（PNG・動画）にもかかります。背景・格子・ボーン・ギズモには、色調補正とブルームはかかりません。設定はプロジェクトに保存します（元に戻す・やり直しの対象ではありません）。" />

    <DockPanel Margin="0,16,0,0" LastChildFill="False">
      <Button DockPanel.Dock="Left" MinWidth="110" Content="初期値に戻す" Click="OnResetClick"
              ToolTip="映像効果をすべて OFF にし、値を初期値に戻します" />
      <Button DockPanel.Dock="Right" MinWidth="88" Content="閉じる" IsCancel="True" IsDefault="True" Click="OnCloseClick" />
    </DockPanel>
  </StackPanel>
</Window>
