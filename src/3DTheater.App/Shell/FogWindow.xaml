<Window x:Class="Theater3D.App.Shell.FogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="霧"
        Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Yu Gothic UI" FontSize="12" UseLayoutRounding="True">
  <Window.Resources>
    <Style x:Key="RowLabelStyle" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="22,0,12,0" />
      <Setter Property="Foreground" Value="{StaticResource SubTextBrush}" />
    </Style>
    <Style x:Key="ValueStyle" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="Margin" Value="8,0,0,0" />
    </Style>
    <Style x:Key="FogSliderStyle" TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,5" />
      <Setter Property="IsMoveToPointEnabled" Value="True" />
    </Style>
    <Style x:Key="ColorBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="Width" Value="118" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,5" />
    </Style>
    <Style x:Key="SwatchStyle" TargetType="Border">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="20" />
      <Setter Property="Margin" Value="8,0,0,0" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    </Style>
  </Window.Resources>

  <StackPanel Margin="18,6,18,16">
    <CheckBox x:Name="EnabledCheck" Margin="0,10,0,4" FontWeight="SemiBold" Content="霧をかける（遠くの物ほど霧の色に溶けこませる）"
              Checked="OnCheckChanged" Unchecked="OnCheckChanged" />
    <Grid IsEnabled="{Binding IsChecked, ElementName=EnabledCheck}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="150" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="56" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock Style="{StaticResource RowLabelStyle}" Text="色" />
      <StackPanel Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal">
        <TextBox x:Name="ColorBox" Style="{StaticResource ColorBoxStyle}" AutomationProperties.Name="霧の色"
                 ToolTip="#RRGGBB（例: 白っぽい青 = #B4BECD）" TextChanged="OnColorChanged" />
        <Border x:Name="ColorSwatch" Style="{StaticResource SwatchStyle}" />
      </StackPanel>
      <TextBlock Grid.Row="1" Style="{StaticResource RowLabelStyle}" Text="始まる距離" ToolTip="カメラからこの距離より先で、霧が始まります" />
      <Slider x:Name="StartSlider" Grid.Row="1" Grid.Column="1" Style="{StaticResource FogSliderStyle}" Minimum="0" Maximum="300"
              SmallChange="1" LargeChange="10" AutomationProperties.Name="霧が始まる距離" ValueChanged="OnSliderChanged" />
      <TextBlock x:Name="StartText" Grid.Row="1" Grid.Column="2" Style="{StaticResource ValueStyle}" />
      <TextBlock Grid.Row="2" Style="{StaticResource RowLabelStyle}" Text="見通せる距離"
                 ToolTip="霧の始まりから、この距離だけ進むと、ほとんど（95%）霧の色になります。小さいほど濃い霧です" />
      <Slider x:Name="VisibilitySlider" Grid.Row="2" Grid.Column="1" Style="{StaticResource FogSliderStyle}" Minimum="5" Maximum="1000"
              SmallChange="5" LargeChange="50" AutomationProperties.Name="見通せる距離" ValueChanged="OnSliderChanged" />
      <TextBlock x:Name="VisibilityText" Grid.Row="2" Grid.Column="2" Style="{StaticResource ValueStyle}" />
      <CheckBox x:Name="GroundOnlyCheck" Grid.Row="3" Grid.ColumnSpan="3" Margin="22,6,0,4"
                Content="地面の近くほど濃くする（高く上がるほど薄くなる）" Checked="OnCheckChanged" Unchecked="OnCheckChanged" />
      <TextBlock Grid.Row="4" Style="{StaticResource RowLabelStyle}" Text="霧の高さ"
                 ToolTip="この高さ上がるごとに、霧の濃さが約 3 分の 1 になります（人の大きさのモデルの背丈は 20 ほど）" />
      <Slider x:Name="HeightSlider" Grid.Row="4" Grid.Column="1" Style="{StaticResource FogSliderStyle}" Minimum="0.5" Maximum="60"
              SmallChange="0.5" LargeChange="2" AutomationProperties.Name="霧の高さ" ValueChanged="OnSliderChanged"
              IsEnabled="{Binding IsChecked, ElementName=GroundOnlyCheck}" />
      <TextBlock x:Name="HeightText" Grid.Row="4" Grid.Column="2" Style="{StaticResource ValueStyle}" />
    </Grid>

    <TextBlock Margin="0,14,0,0" TextWrapping="Wrap" Foreground="{StaticResource SubTextBrush}" FontSize="11.5"
               Text="カメラから遠い物ほど、霧の色に溶けこませます。背景が色のときは背景も霧の色になります（透明な背景の書き出しは透明のままです）。正面・側面などの固定の視点（平行投影）にはかかりません。変えるとすぐにプレビューへ反映し、書き出しにもかかります。設定はプロジェクトに保存します（元に戻す・やり直しの対象ではありません）。" />

    <DockPanel Margin="0,16,0,0" LastChildFill="False">
      <Button DockPanel.Dock="Left" MinWidth="110" Content="初期値に戻す" Click="OnResetClick" ToolTip="霧を OFF にし、値を初期値に戻します" />
      <Button DockPanel.Dock="Right" MinWidth="88" Content="閉じる" IsCancel="True" IsDefault="True" Click="OnCloseClick" />
    </DockPanel>
  </StackPanel>
</Window>
