<Window x:Class="Theater3D.App.Shell.ModeSelectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="3D Theater - モードを選ぶ"
        Width="640" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Yu Gothic UI" FontSize="12" UseLayoutRounding="True">
  <Window.Resources>
    <Style x:Key="ModeButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Padding" Value="16,14" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Top" />
      <Setter Property="MinHeight" Value="132" />
    </Style>
    <Style x:Key="ModeTitleStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="ModeNoteStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource SubTextBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,8,0,0" />
    </Style>
  </Window.Resources>

  <StackPanel Margin="20,16,20,16">
    <TextBlock FontSize="18" Text="どちらのモードで始めますか？" />
    <TextBlock Style="{StaticResource ModeNoteStyle}" Margin="0,4,0,0"
               Text="保存するファイルは、モードごとに拡張子が分かれます。ファイルをダブルクリックしたときは、選ばずにそのモードで開きます。" />

    <Grid Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Button x:Name="EditButton" Style="{StaticResource ModeButtonStyle}" AutomationProperties.Name="エディットモード" Click="OnEditClick">
        <StackPanel>
          <TextBlock Style="{StaticResource ModeTitleStyle}" Text="エディットモード" />
          <TextBlock Style="{StaticResource ModeNoteStyle}" Text="キーフレームでモーションを付け、画像や動画に書き出します。" />
          <TextBlock Style="{StaticResource ModeNoteStyle}" Text="保存: .3dtproj" />
        </StackPanel>
      </Button>
      <Button x:Name="LiveButton" Grid.Column="2" Style="{StaticResource ModeButtonStyle}" AutomationProperties.Name="ライブモード" Click="OnLiveClick">
        <StackPanel>
          <TextBlock Style="{StaticResource ModeTitleStyle}" Text="ライブモード" />
          <TextBlock Style="{StaticResource ModeNoteStyle}" Text="部屋・小物・キャラクターを置き、配信などでその場で動かします。" />
          <TextBlock Style="{StaticResource ModeNoteStyle}" Text="保存: .3dtlive" />
        </StackPanel>
      </Button>
    </Grid>

    <DockPanel Margin="0,16,0,0" LastChildFill="False">
      <Button DockPanel.Dock="Left" MinWidth="120" Content="ファイルを開く..." AutomationProperties.Name="ファイルを開く" Click="OnOpenClick"
              ToolTip="エディット（.3dtproj）かライブ（.3dtlive）のファイルを選び、そのモードで開きます" />
      <Button DockPanel.Dock="Right" MinWidth="88" Content="やめる" IsCancel="True" Click="OnCancelClick" />
    </DockPanel>
    <CheckBox x:Name="AssociationCheck" Margin="0,14,0,0" AutomationProperties.Name="ダブルクリックで開けるようにする" Click="OnAssociationClick"
              Content=".3dtproj と .3dtlive をダブルクリックで開けるようにする（この PC の今の利用者に登録）"
              ToolTip="エクスプローラーでファイルをダブルクリックしたときに、このアプリのそのモードで開くようにします。管理者の権限は要りません。外すと登録を消します" />
    <TextBlock x:Name="AssociationNote" Style="{StaticResource ModeNoteStyle}" Margin="24,4,0,0" />
  </StackPanel>
</Window>
