<Window x:Class="Theater3D.App.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ad="https://github.com/Dirkster99/AvalonDock"
        xmlns:shell="clr-namespace:Theater3D.App.Shell"
        Title="3D Theater"
        Width="1440" Height="900" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Yu Gothic UI" FontSize="12"
        UseLayoutRounding="True"
        AllowDrop="True" PreviewDragOver="OnPreviewDragOver" PreviewDrop="OnPreviewDrop">
  <!-- メニューをタイトルバーに入れるため、タイトルバーを自前で描く（指示書 2.2） -->
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="34" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <Style x:Key="PlannedItemStyle" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
      <Setter Property="IsEnabled" Value="False" />
      <Setter Property="InputGestureText" Value="予定" />
      <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
    </Style>
  </Window.Resources>

  <Border x:Name="RootBorder">
    <DockPanel>
      <!-- タイトルバー: アプリのアイコン・メニュー・（空き = ドラッグで移動）・最小化/最大化/閉じる -->
      <Grid DockPanel.Dock="Top" Height="34" Background="{StaticResource TitleBarBrush}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Image x:Name="TitleIcon" Width="16" Height="16" Margin="12,0,6,0" VerticalAlignment="Center" />
        <Menu x:Name="MainMenu" Grid.Column="1" VerticalAlignment="Center" Background="Transparent" FontSize="12"
              WindowChrome.IsHitTestVisibleInChrome="True" ItemContainerStyle="{StaticResource TitleMenuItemStyle}">
          <MenuItem Header="ファイル(_F)">
            <MenuItem Header="新規プロジェクト(_N)" InputGestureText="Ctrl+N" Click="OnNewProjectClick" />
            <MenuItem Header="開く(_O)..." InputGestureText="Ctrl+O" Click="OnOpenProjectClick"
                      ToolTip="プロジェクト（.3dtproj）を開きます（ウィンドウへのドラッグでも開けます）" />
            <MenuItem Header="保存(_S)" InputGestureText="Ctrl+S" Click="OnSaveProjectClick"
                      ToolTip="モデルの場所・置き方・ボーンとモーフのキー・カメラなどを保存します（モデルのファイルそのものは書き換えません）" />
            <MenuItem Header="名前を付けて保存(_A)..." InputGestureText="Ctrl+Shift+S" Click="OnSaveProjectAsClick" />
            <Separator />
            <MenuItem Header="モデル・アクセサリを読み込む（PMX / X / VAC）..." InputGestureText="Ctrl+I" Click="OnImportModelClick"
                      ToolTip="PMX モデルをシーンに加えて表示します（ドラッグでも読み込めます）" />
            <MenuItem Header="モーション・ポーズを読み込む（VMD / VPD）..." Click="OnImportMotionClick" shell:ModeOnly.Edit="True"
                      ToolTip="今操作しているモデルに当てはめます（ウィンドウへのドラッグでも読み込めます）" />
            <MenuItem Header="音声を読み込む（WAV / MP3 など）..." Click="OnImportAudioClick" shell:ModeOnly.Edit="True"
                      ToolTip="曲などを読み込み、再生に合わせて鳴らします（音声は 1 つまで。ウィンドウへのドラッグでも読み込めます）" />
            <MenuItem Header="音声を外す" Click="OnRemoveAudioClick" shell:ModeOnly.Edit="True" ToolTip="シーンから音声を外します（ファイルは消しません。Ctrl+Z で戻せます）" />
            <MenuItem Header="書き出す（PNG・連番・動画）..." Click="OnExportStillClick" shell:ModeOnly.Edit="True"
                      ToolTip="シーンのカメラから見た絵を PNG で書き出します（レンダリングのメニューと同じ）" />
            <!-- プラグインのファイルの形式（あるときだけ出す） -->
            <MenuItem x:Name="PluginImportMenu" Header="読み込む（プラグインの形式）" Visibility="Collapsed" SubmenuOpened="OnPluginFileMenuOpened" />
            <MenuItem x:Name="PluginExportMenu" Header="書き出す（プラグインの形式）" Visibility="Collapsed" SubmenuOpened="OnPluginFileMenuOpened" />
            <Separator />
            <MenuItem x:Name="OtherModeMenuItem" Click="OnStartOtherModeClick"
                      ToolTip="もう一方のモードを、別の窓（別のアプリ）で起動します。今の窓の作業はそのまま残ります" />
            <Separator />
            <MenuItem Header="終了(_X)" InputGestureText="Alt+F4" Click="OnExitClick" />
          </MenuItem>
          <MenuItem Header="編集(_E)" SubmenuOpened="OnEditMenuOpened">
            <MenuItem x:Name="UndoMenuItem" Header="元に戻す(_U)" InputGestureText="Ctrl+Z" Click="OnUndoClick" />
            <MenuItem x:Name="RedoMenuItem" Header="やり直し(_R)" InputGestureText="Ctrl+Y" Click="OnRedoClick" />
            <Separator shell:ModeOnly.Edit="True" />
            <MenuItem x:Name="CopyKeysMenuItem" Header="キーをコピー(_C)" InputGestureText="Ctrl+C" Click="OnCopyKeysClick" shell:ModeOnly.Edit="True"
                      ToolTip="タイムラインで選んだキーをコピーします" />
            <MenuItem x:Name="PasteKeysMenuItem" Header="キーを今のフレームに貼り付け(_P)" InputGestureText="Ctrl+V" Click="OnPasteKeysClick" shell:ModeOnly.Edit="True" />
            <MenuItem x:Name="DeleteKeysMenuItem" Header="キーを削除(_D)" InputGestureText="Delete" Click="OnDeleteKeysClick" shell:ModeOnly.Edit="True" />
            <Separator />
            <MenuItem Header="すべて選択(_A)" InputGestureText="Ctrl+A" Click="OnSelectAllClick" />
            <MenuItem Header="選択を解除" InputGestureText="Esc" Click="OnClearSelectionClick" />
          </MenuItem>
          <MenuItem x:Name="ViewMenu" Header="表示(_V)" SubmenuOpened="OnViewMenuOpened">
            <MenuItem x:Name="PanelsMenu" Header="パネル(_P)" />
            <MenuItem Header="プレビューを追加(_N)" Click="OnAddPreviewClick" />
            <Separator />
            <MenuItem Header="1 画面" Tag="Single" Click="OnPreviewLayoutClick" />
            <MenuItem Header="2 画面" Tag="SideBySide" Click="OnPreviewLayoutClick" />
            <MenuItem Header="4 画面" Tag="Quad" Click="OnPreviewLayoutClick" />
            <Separator />
            <MenuItem x:Name="ViewKindsMenu" Header="視点(_W)" />
            <MenuItem Header="透視投影と平行投影を切り替える" InputGestureText="Num5" Click="OnToggleProjectionClick" />
            <Separator />
            <MenuItem Header="レイアウトを初期配置に戻す(_R)" Click="OnResetLayoutClick" />
          </MenuItem>
          <MenuItem Header="シーン(_S)">
            <MenuItem Header="アクセサリを追加（.x / .vac）..." Click="OnImportAccessoryClick"
                      ToolTip="MMD のアクセサリ（DirectX の .x。テキスト・バイナリ・圧縮）を、MMD と同じく 10 倍の大きさで読み込みます。.vac なら、書かれたボーン（右手首など）に付けて置きます（選んでいるモデルにそのボーンがあれば、そのモデルに）" />
            <MenuItem Header="照明を追加">
              <MenuItem Header="点光源" Tag="Point" Click="OnAddLightClick"
                        ToolTip="電球のように全方向を照らす照明を足します（届く距離で 0 になります）" />
              <MenuItem Header="スポットライト" Tag="Spot" Click="OnAddLightClick"
                        ToolTip="回転の向きへ円すいの形に照らす照明を足します" />
              <MenuItem Header="平行光" Tag="Directional" Click="OnAddLightClick"
                        ToolTip="太陽のように、どこでも同じ向きから照らす照明を足します（縁を明るくする光などに）" />
            </MenuItem>
            <MenuItem Header="選んだ照明を外す" Click="OnRemoveLightClick"
                      ToolTip="足した照明をシーンから外します（MMD の照明は外せません。Ctrl+Z で戻せます）" />
            <MenuItem Header="カメラを追加" Style="{StaticResource PlannedItemStyle}" ToolTip="まだできません（シーンのカメラは今は 1 つです。カメラを足すのは今後対応します）" />
          </MenuItem>
          <MenuItem Header="モデル(_M)">
            <MenuItem Header="PMX・アクセサリを読み込む..." InputGestureText="Ctrl+I" Click="OnImportModelClick"
                      ToolTip="PMX モデルをシーンに加えて表示します（ドラッグでも読み込めます）" />
            <MenuItem Header="選んだモデルを外す" InputGestureText="Delete" Click="OnRemoveModelClick"
                      ToolTip="選んだモデルをシーンから外します（モデルのファイルは消しません。Ctrl+Z で戻せます）" />
            <Separator />
            <MenuItem x:Name="PhysicsMenuItem" Header="物理演算" IsCheckable="True" Click="OnPhysicsClick"
                      ToolTip="剛体とジョイントで、髪・スカートなどを揺らします（初期値は ON。プロジェクトに保存します）" />
            <MenuItem x:Name="PhysicsFloorMenuItem" Header="物理を床に当てる" IsCheckable="True" Click="OnPhysicsFloorClick"
                      ToolTip="髪・スカートなど物理で動く部分が、床（高さ 0）をすり抜けないようにします（初期値は ON。プロジェクトに保存します）" />
            <MenuItem x:Name="PhysicsBetweenModelsMenuItem" Header="物理をモデルどうしで当てる" IsCheckable="True" Click="OnPhysicsBetweenModelsClick"
                      ToolTip="髪・スカートなど物理で動く部分が、ほかのモデルの体をすり抜けないようにします（ほかのモデルの髪どうしは当たりません。初期値は ON。プロジェクトに保存します）" />
            <MenuItem Header="物理をリセット" Click="OnResetPhysicsClick"
                      ToolTip="剛体を今の姿勢に置き直して、落ち着かせます（揺れが暴れたときなど）" />
            <Separator />
            <MenuItem Header="材質の設定..." Click="OnMaterialsClick"
                      ToolTip="選んだモデルの材質を、PBR（金属らしさ・粗さ）や発光で上書きします。PMX の材質は書き換えません（プロジェクトに保存し、元に戻せます）" />
          </MenuItem>
          <MenuItem x:Name="LiveMenu" Header="ライブ(_L)" SubmenuOpened="OnLiveMenuOpened" shell:ModeOnly.Live="True">
            <MenuItem x:Name="OutputMenuItem" Header="配信用の画面を出す" IsCheckable="True" Click="OnOutputClick"
                      ToolTip="シーンのカメラから見た絵だけを、別の窓に出します（格子・ボーン・ギズモは出しません）。OBS などのウィンドウキャプチャで取り込み、背景の色をクロマキーで抜きます" />
            <MenuItem x:Name="OutputSizeMenu" Header="配信用の画面の大きさ"
                      ToolTip="配信用の画面の中（描く絵）の大きさ。窓の大きさを手で変えると、絵もその大きさで描きます（ライブのファイルに保存します）" />
            <MenuItem x:Name="OutputBackgroundMenu" Header="配信用の画面の背景"
                      ToolTip="背景を塗る色（クロマキーで抜く色）。環境の画像を背景に出しているときは、その画像を描きます（ライブのファイルに保存します）" />
            <MenuItem x:Name="OutputTopmostMenuItem" Header="配信用の画面をいつも手前に出す" IsCheckable="True" Click="OnOutputTopmostClick" />
            <Separator />
            <MenuItem Header="待機モーション・ポーズを読み込む（VMD / VPD）..." Click="OnImportMotionClick"
                      ToolTip="選んだモデル（キャラクター）に当てはめます。モーションは、そのモーションの長さで繰り返します。ポーズはその姿勢のままにします（ウィンドウへのドラッグでも読み込めます）" />
            <MenuItem Header="待機モーションを外す" Click="OnRemoveIdleMotionClick"
                      ToolTip="選んだモデルのモーションのキーを消し、姿勢を初期の形に戻します（Ctrl+Z で戻せます）" />
          </MenuItem>
          <MenuItem Header="モーション(_A)" SubmenuOpened="OnMotionMenuOpened" shell:ModeOnly.Edit="True">
            <MenuItem Header="モーション・ポーズを読み込む（VMD / VPD）..." Click="OnImportMotionClick" />
            <MenuItem Header="モーションを書き出す（VMD）..." Click="OnExportMotionClick"
                      ToolTip="今操作しているモデルのボーン・モーフのキーを、MMD のモーションとして書き出します" />
            <MenuItem Header="ポーズを書き出す（VPD）..." Click="OnExportPoseClick"
                      ToolTip="今操作しているモデルの、今のフレームの姿勢を書き出します" />
            <MenuItem Header="カメラ・照明のモーションを書き出す（VMD）..." Click="OnExportCameraClick"
                      ToolTip="シーンのカメラと MMD の照明のキーを、MMD のカメラ・照明のモーションとして書き出します" />
            <Separator />
            <MenuItem Header="キーフレームを登録" InputGestureText="I" Click="OnRegisterKeysClick"
                      ToolTip="選んだボーン・モーフを、今のフレームのキーにします" />
            <MenuItem x:Name="AutoKeyMenuItem" Header="自動キーフレーム" IsCheckable="True" Click="OnAutoKeyClick"
                      ToolTip="ON にすると、値を変えたときに今のフレームへキーを登録します（初期値は OFF）" />
          </MenuItem>
          <MenuItem Header="カメラ(_C)">
            <MenuItem Header="選択した物に合わせる" InputGestureText="Num ." Click="OnFocusSelectionClick" />
            <MenuItem Header="視点を初期状態に戻す" InputGestureText="Home" Click="OnResetViewClick" />
            <MenuItem Header="カメラ視点にする" InputGestureText="Num0" Tag="Camera" Click="OnViewKindClick" />
          </MenuItem>
          <MenuItem Header="レンダリング(_R)">
            <MenuItem x:Name="SelfShadowMenuItem" Header="セルフシャドウ" IsCheckable="True" Click="OnSelfShadowClick"
                      ToolTip="モデルに落ちる影を描きます。影を受ける材質は、影の中をトゥーンの影の色で描きます（MMD と同じ。初期値は ON。プロジェクトに保存します）" />
            <MenuItem x:Name="GroundShadowMenuItem" Header="地面の影" IsCheckable="True" Click="OnGroundShadowClick"
                      ToolTip="高さ 0 の床に、照明の向きに沿ってモデルの影を描きます（初期値は ON。プロジェクトに保存します）" />
            <MenuItem Header="影の設定..." Click="OnShadowClick"
                      ToolTip="影のやわらかさ（セルフシャドウと地面の影の境目を、離れた所ほどぼかす）と、地面の影の濃さを変えます（プロジェクトに保存します）" />
            <MenuItem Header="床の映り込み..." Click="OnReflectionClick"
                      ToolTip="高さ 0 の床に、モデルを鏡のように映します（濃さ・消えるまでの距離。書き出しにもかかります。プロジェクトに保存します）" />
            <MenuItem Header="環境の画像..." Click="OnEnvironmentClick"
                      ToolTip="全方向の景色の HDR 画像（HDRI）で、PBR の材質を照らし、映り込ませます。背景にも表示できます（プロジェクトに保存します）" />
            <MenuItem Header="霧..." Click="OnFogClick"
                      ToolTip="遠くの物ほど霧の色に溶けこませます（色・始まる距離・見通せる距離・地面の近くほど濃く）。書き出しにもかかります（プロジェクトに保存します）" />
            <MenuItem Header="映像効果..." Click="OnEffectsClick"
                      ToolTip="色調補正（明るさ・コントラスト・彩度・色温度）、ブルーム、周辺減光、環境光の遮り、被写界深度を設定します。書き出しにもかかります（プロジェクトに保存します）" />
            <MenuItem Header="イラスト風..." Click="OnIllustrationClick"
                      ToolTip="線画・塗り（明るさの段階を減らす）・影の色・紙の質感を設定します。書き出しにもかかります（プロジェクトに保存します）" />
            <Separator shell:ModeOnly.Edit="True" />
            <MenuItem Header="静止画を書き出す（PNG）..." Click="OnExportStillClick" shell:ModeOnly.Edit="True"
                      ToolTip="今のフレームを、シーンのカメラから見た絵で PNG に書き出します（背景の透過もできます）" />
            <MenuItem Header="連番を書き出す（PNG）..." Click="OnExportSequenceClick" shell:ModeOnly.Edit="True"
                      ToolTip="フレームの範囲を 1 フレーム 1 枚の PNG で書き出します（名前_0000.png …）" />
            <MenuItem Header="動画を書き出す（MP4）..." Click="OnExportVideoClick" shell:ModeOnly.Edit="True"
                      ToolTip="フレームの範囲を MP4 の動画（H.264・AAC）で書き出します。シーンの音声も入れられます" />
            <Separator />
            <MenuItem Header="描画品質の設定..." Click="OnRenderQualityClick"
                      ToolTip="プレビューの品質（軽い・ふつう・きれい。線や輪郭のなめらかさと影の細かさ）を選びます。書き出しはいつも高い品質で描きます" />
          </MenuItem>
          <MenuItem Header="ツール(_T)" SubmenuOpened="OnToolsMenuOpened">
            <MenuItem x:Name="AssociationMenuItem" Header=".3dtproj・.3dtlive をダブルクリックで開けるようにする" IsCheckable="True" Click="OnAssociationClick"
                      ToolTip="エクスプローラーでファイルをダブルクリックしたときに、このアプリのそのモード（.3dtproj はエディット、.3dtlive はライブ）で開くようにします。この PC の今の利用者に登録し、管理者の権限は要りません。外すと登録を消します" />
            <Separator />
            <MenuItem Header="設定..." Style="{StaticResource PlannedItemStyle}" ToolTip="まだできません（操作感度・ショートカットの設定は今後対応します）" />
          </MenuItem>
          <MenuItem x:Name="PluginsMenu" Header="プラグイン(_P)" />
          <MenuItem Header="ヘルプ(_H)">
            <MenuItem Header="操作方法" Click="OnShortcutsClick" />
            <MenuItem Header="ログフォルダーを開く(_L)" Click="OnOpenLogFolderClick" />
            <MenuItem Header="GPU を作り直す（表示がおかしいとき）" Click="OnRecoverGpuClick"
                      ToolTip="GPU の資源を全部作り直して描き直す。GPU が使えなくなったときに自動で行うのと同じ手順" />
            <Separator />
            <MenuItem Header="バージョン情報(_A)" Click="OnAboutClick" />
          </MenuItem>
        </Menu>
        <TextBlock Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                   Foreground="{StaticResource DisabledTextBrush}" x:Name="TitleText" Text="無題 - 3D Theater" />
        <StackPanel Grid.Column="3" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
          <Button Style="{StaticResource CaptionButtonStyle}" Content="&#xE921;" ToolTip="最小化" Click="OnMinimizeClick" />
          <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButtonStyle}" Content="&#xE922;" Click="OnMaximizeClick" />
          <Button Style="{StaticResource CloseCaptionButtonStyle}" Content="&#xE8BB;" ToolTip="閉じる" Click="OnExitClick" />
        </StackPanel>
      </Grid>

      <!-- ツールバー（タイトルバーのすぐ下の独立した 1 段） -->
      <Border DockPanel.Dock="Top" Height="38" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,1">
        <DockPanel Margin="6,0" LastChildFill="False">
          <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Style="{StaticResource IconButtonStyle}" Content="&#xE8A5;" ToolTip="新規プロジェクト（Ctrl+N）" Click="OnNewProjectClick" />
            <Button Style="{StaticResource IconButtonStyle}" Content="&#xE8E5;" ToolTip="開く（Ctrl+O）" Click="OnOpenProjectClick" />
            <Button Style="{StaticResource IconButtonStyle}" Content="&#xE74E;" ToolTip="保存（Ctrl+S）" Click="OnSaveProjectClick" />
            <Rectangle Style="{StaticResource ToolbarSeparatorStyle}" />
            <Button x:Name="UndoButton" Style="{StaticResource IconButtonStyle}" Content="&#xE7A7;" IsEnabled="False" ToolTip="元に戻す（Ctrl+Z）"
                    Click="OnUndoClick" ToolTipService.ShowOnDisabled="True" />
            <Button x:Name="RedoButton" Style="{StaticResource IconButtonStyle}" Content="&#xE7A6;" IsEnabled="False" ToolTip="やり直し（Ctrl+Y）"
                    Click="OnRedoClick" ToolTipService.ShowOnDisabled="True" />
            <Rectangle Style="{StaticResource ToolbarSeparatorStyle}" />
            <ComboBox x:Name="GizmoStyleCombo" Width="120" MinHeight="0" Padding="8,2" FontSize="12" VerticalAlignment="Center"
                      SelectionChanged="OnGizmoStyleChanged"
                      ToolTip="ギズモの方式。MMD 方式は移動と回転の取っ手を一緒に出し、Blender 方式は選んだ道具の取っ手だけを出します（切り替えても姿勢やキーは変わりません）">
              <ComboBoxItem Content="MMD 方式" />
              <ComboBoxItem Content="Blender 方式" />
            </ComboBox>
            <ToggleButton x:Name="SelectToolButton" Margin="4,0,0,0" Style="{StaticResource IconToggleButtonStyle}" Content="&#xE7C9;"
                          Tag="Select" Click="OnGizmoToolClick" ToolTipService.ShowOnDisabled="True" ToolTip="選択（Q）: 取っ手を出さずに選ぶ" />
            <ToggleButton x:Name="MoveToolButton" Style="{StaticResource IconToggleButtonStyle}" Content="&#xE7C2;"
                          Tag="Move" Click="OnGizmoToolClick" ToolTipService.ShowOnDisabled="True" ToolTip="移動（W）: XYZ の矢印をドラッグして動かす" />
            <ToggleButton x:Name="RotateToolButton" Style="{StaticResource IconToggleButtonStyle}" Content="&#xE7AD;"
                          Tag="Rotate" Click="OnGizmoToolClick" ToolTipService.ShowOnDisabled="True" ToolTip="回転（E）: XYZ の輪をドラッグして回す" />
            <ComboBox x:Name="GizmoSpaceCombo" Width="96" Margin="6,0,0,0" MinHeight="0" Padding="8,2" FontSize="12" VerticalAlignment="Center"
                      SelectionChanged="OnGizmoSpaceChanged"
                      ToolTip="ギズモの軸。ワールドはシーンの XYZ、ローカルは選んだ物（ボーン）の向きの XYZ。Ctrl を押しながらドラッグでスナップ（移動 0.5・回転 5°）">
              <ComboBoxItem Content="ワールド" />
              <ComboBoxItem Content="ローカル" />
            </ComboBox>
            <Rectangle Style="{StaticResource ToolbarSeparatorStyle}" />
            <Button Style="{StaticResource TextButtonStyle}" Click="OnAddPreviewClick" ToolTip="プレビューを追加">
              <StackPanel Orientation="Horizontal">
                <TextBlock FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Text="&#xE710;" />
                <TextBlock Margin="5,0,0,0" VerticalAlignment="Center" Text="プレビュー" />
              </StackPanel>
            </Button>
            <Button Style="{StaticResource TextButtonStyle}" Content="1 画面" Tag="Single" Click="OnPreviewLayoutClick" ToolTip="選んでいるプレビューを 1 画面にする" />
            <Button Style="{StaticResource TextButtonStyle}" Content="2 画面" Tag="SideBySide" Click="OnPreviewLayoutClick" ToolTip="選んでいるプレビューを 2 画面にする" />
            <Button Style="{StaticResource TextButtonStyle}" Content="4 画面" Tag="Quad" Click="OnPreviewLayoutClick" ToolTip="選んでいるプレビューを 4 画面にする" />
            <Rectangle Style="{StaticResource ToolbarSeparatorStyle}" />
            <Button x:Name="PlayButton" Style="{StaticResource IconButtonStyle}" Content="&#xE768;" Click="OnPlayClick" ToolTip="再生 / 一時停止（Space）" shell:ModeOnly.Edit="True" />
            <ToggleButton x:Name="PhysicsButton" Style="{StaticResource TextButtonStyle}" Content="物理"
                          Checked="OnPhysicsButtonToggled" Unchecked="OnPhysicsButtonToggled"
                          ToolTip="物理演算（髪・スカートなどの揺れ）の ON / OFF" />
            <!-- プラグインのボタン（あるときだけ区切り線を出す） -->
            <Rectangle x:Name="PluginToolbarSeparator" Style="{StaticResource ToolbarSeparatorStyle}" Visibility="Collapsed" />
            <StackPanel x:Name="PluginToolbar" Orientation="Horizontal" />
          </StackPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Style="{StaticResource TextButtonStyle}" Click="OnResetLayoutClick" ToolTip="パネルの並びを初期配置に戻す">
              <StackPanel Orientation="Horizontal">
                <TextBlock FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Text="&#xE72C;" />
                <TextBlock Margin="5,0,0,0" VerticalAlignment="Center" Text="初期配置" />
              </StackPanel>
            </Button>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- 状態表示 -->
      <Border DockPanel.Dock="Bottom" Height="26" Background="{StaticResource TitleBarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="10,0">
        <DockPanel LastChildFill="True">
          <TextBlock x:Name="VideoMemoryText" DockPanel.Dock="Right" Margin="18,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource SubTextBrush}" />
          <TextBlock x:Name="FrameRateText" DockPanel.Dock="Right" Margin="18,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource SubTextBrush}" />
          <TextBlock x:Name="RendererText" DockPanel.Dock="Right" Margin="18,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource SubTextBrush}" />
          <TextBlock x:Name="FrameText" DockPanel.Dock="Right" Margin="18,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource SubTextBrush}" shell:ModeOnly.Edit="True" />
          <TextBlock x:Name="PhysicsText" DockPanel.Dock="Right" Margin="18,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource SubTextBrush}" shell:ModeOnly.Edit="True"
                     ToolTip="物理の焼き込み（0 フレーム目から順に計算した結果を覚えておく）の進み具合。できたフレームは、どこから来ても同じ姿勢になります" />
          <!-- プラグインの欄（アプリの欄の左） -->
          <StackPanel x:Name="PluginStatusArea" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" />
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse x:Name="StatusDot" Width="8" Height="8" Margin="0,0,8,0" Fill="#FF3FB950" />
            <TextBlock x:Name="StatusText" TextTrimming="CharacterEllipsis" Text="準備完了" />
          </StackPanel>
        </DockPanel>
      </Border>

      <ad:DockingManager x:Name="Dock" AllowMixedOrientation="True" />
    </DockPanel>
  </Border>
</Window>
