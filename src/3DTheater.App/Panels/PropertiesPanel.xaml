<UserControl x:Class="Theater3D.App.Panels.PropertiesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Theater3D.App.Controls"
             Background="{StaticResource PanelBrush}">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <c:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />

    <Style x:Key="RowLabelStyle" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,6,0" />
    </Style>
    <Style x:Key="AxisLabelStyle" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="6,0,3,0" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style TargetType="c:NumberBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Padding" Value="4,1" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="IsReadOnly" Value="{Binding IsEditable, Converter={x:Static c:BoolNegation.Instance}}" />
    </Style>
    <SolidColorBrush x:Key="AxisXBrush" Color="#FFE05252" />
    <SolidColorBrush x:Key="AxisYBrush" Color="#FF5BC46A" />
    <SolidColorBrush x:Key="AxisZBrush" Color="#FF4A7EEA" />
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="10,8">
      <TextBlock Text="何も選択されていません。シーン一覧かプレビューで項目を選んでください。" TextWrapping="Wrap"
                 Foreground="{StaticResource SubTextBrush}"
                 Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVisibility}}" />
      <TextBlock Text="{Binding SelectionSummary}" TextWrapping="Wrap" Foreground="{StaticResource SubTextBrush}"
                 Visibility="{Binding IsMultiple, Converter={StaticResource BoolToVisibility}}" />

      <StackPanel Visibility="{Binding IsSingle, Converter={StaticResource BoolToVisibility}}">
        <!-- 名前と表示 -->
        <TextBlock Text="{Binding KindName}" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,4" />
        <DockPanel>
          <CheckBox DockPanel.Dock="Right" Margin="8,0,0,0" MinWidth="0" Content="表示" IsChecked="{Binding NodeIsVisible}" />
          <TextBox MinHeight="0" Height="26" Padding="6,2" FontSize="13" IsEnabled="{Binding CanRename}"
                   Text="{Binding NodeName, UpdateSourceTrigger=LostFocus}" />
        </DockPanel>
        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#FFE0A040"
                   Text="＊ キーに登録していない変更があります。フレームを動かしても値は保ちます（タイムラインの「すべて登録」か「破棄」で決めます。I で選んだ項目を登録）。"
                   Visibility="{Binding HasUnregisteredChange, Converter={StaticResource BoolToVisibility}}" />
        <TextBlock Margin="0,6,0,0" Text="編集ロック中のため変更できません（シーン一覧の鍵で外せます）。"
                   Style="{StaticResource PlannedNoteStyle}" Foreground="#FFE0A040"
                   Visibility="{Binding IsLockedNoteVisible, Converter={StaticResource BoolToVisibility}}" />

        <!-- トランスフォーム（ボーンでは移動・回転） -->
        <StackPanel Visibility="{Binding HasTransform, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="{Binding TransformHeader}" Style="{StaticResource SectionHeaderStyle}" Margin="0,14,0,6" />
          <Grid Height="28" Visibility="{Binding ShowsPosition, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="44" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding PositionLabel}" Style="{StaticResource RowLabelStyle}" />
            <TextBlock Grid.Column="1" Text="X" Style="{StaticResource AxisLabelStyle}" Foreground="{StaticResource AxisXBrush}" />
            <c:NumberBox Grid.Column="2" Value="{Binding PositionX}" Step="0.1" />
            <TextBlock Grid.Column="3" Text="Y" Style="{StaticResource AxisLabelStyle}" Foreground="{StaticResource AxisYBrush}" />
            <c:NumberBox Grid.Column="4" Value="{Binding PositionY}" Step="0.1" />
            <TextBlock Grid.Column="5" Text="Z" Style="{StaticResource AxisLabelStyle}" Foreground="{StaticResource AxisZBrush}" />
            <c:NumberBox Grid.Column="6" Value="{Binding PositionZ}" Step="0.1" />
          </Grid>
          <Grid Height="28" Visibility="{Binding ShowsRotation, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="44" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="回転" Style="{StaticResource RowLabelStyle}" ToolTip="度。X = 上下の向き、Y = 左右の向き、Z = 傾き" />
            <TextBlock Grid.Column="1" Text="X" Style="{StaticResource AxisLabelStyle}" Foreground="{StaticResource AxisXBrush}" />
            <c:NumberBox Grid.Column="2" Value="{Binding RotationX}" Step="1" Format="0.00°" />
            <TextBlock Grid.Column="3" Text="Y" Style="{StaticResource AxisLabelStyle}" Foreground="{StaticResource AxisYBrush}" />
            <c:NumberBox Grid.Column="4" Value="{Binding RotationY}" Step="1" Format="0.00°" />
            <TextBlock Grid.Column="5" Text="Z" Style="{StaticResource AxisLabelStyle}" Foreground="{StaticResource AxisZBrush}" />
            <c:NumberBox Grid.Column="6" Value="{Binding RotationZ}" Step="1" Format="0.00°" />
          </Grid>
          <Grid Height="28" Visibility="{Binding CanScale, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="44" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="拡大" Style="{StaticResource RowLabelStyle}" />
            <TextBlock Grid.Column="1" Text="X" Style="{StaticResource AxisLabelStyle}" Foreground="{StaticResource AxisXBrush}" />
            <c:NumberBox Grid.Column="2" Value="{Binding ScaleX}" Step="0.1" />
            <TextBlock Grid.Column="3" Text="Y" Style="{StaticResource AxisLabelStyle}" Foreground="{StaticResource AxisYBrush}" />
            <c:NumberBox Grid.Column="4" Value="{Binding ScaleY}" Step="0.1" />
            <TextBlock Grid.Column="5" Text="Z" Style="{StaticResource AxisLabelStyle}" Foreground="{StaticResource AxisZBrush}" />
            <c:NumberBox Grid.Column="6" Value="{Binding ScaleZ}" Step="0.1" />
          </Grid>
        </StackPanel>

        <!-- ボーン -->
        <StackPanel Visibility="{Binding IsBone, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="ボーンの情報" Style="{StaticResource SectionHeaderStyle}" Margin="0,14,0,6" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="72" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="親ボーン" Style="{StaticResource RowLabelStyle}" Margin="0,2,6,2" />
            <TextBlock Grid.Column="1" Margin="0,2" Text="{Binding BoneParentText}" TextWrapping="Wrap" />
            <TextBlock Grid.Row="1" Text="性質" Style="{StaticResource RowLabelStyle}" VerticalAlignment="Top" Margin="0,2,6,2" />
            <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,2" Text="{Binding BoneTraitsText}" TextWrapping="Wrap" />
            <TextBlock Grid.Row="2" Text="キー" Style="{StaticResource RowLabelStyle}" Margin="0,2,6,2" />
            <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,2" Text="{Binding KeyCountText}" />
          </Grid>
          <TextBlock Margin="0,6,0,0" Style="{StaticResource PlannedNoteStyle}"
                     Visibility="{Binding IsBoneIkLinkNote, Converter={StaticResource BoolToVisibility}}"
                     Text="IK で動くボーンです。ここでの回転は IK の計算の出発点になり、IK の向きが優先されます。" />
          <Button Margin="0,8,0,0" HorizontalAlignment="Left" Content="このボーンを初期の姿勢に戻す" Click="OnResetBoneClick"
                  IsEnabled="{Binding IsEditable}" />
          <TextBlock Margin="0,8,0,0" Style="{StaticResource PlannedNoteStyle}"
                     Text="移動・回転は親のボーンから見た向きで、回転は Z → X → Y の順に回します。ギズモでの操作は次の段階で対応します。" />
        </StackPanel>

        <!-- モーフ -->
        <StackPanel Visibility="{Binding IsMorph, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="モーフ" Style="{StaticResource SectionHeaderStyle}" Margin="0,14,0,6" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="72" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="84" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="22" />
              <RowDefinition Height="22" />
              <RowDefinition Height="30" />
              <RowDefinition Height="22" />
            </Grid.RowDefinitions>
            <TextBlock Text="種類" Style="{StaticResource RowLabelStyle}" />
            <TextBlock Grid.Column="1" Grid.ColumnSpan="2" VerticalAlignment="Center" Text="{Binding Morph.TypeName}" />
            <TextBlock Grid.Row="1" Text="分類" Style="{StaticResource RowLabelStyle}" />
            <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" VerticalAlignment="Center" Text="{Binding MorphCategoryText}" />
            <TextBlock Grid.Row="3" Text="キー" Style="{StaticResource RowLabelStyle}" />
            <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" VerticalAlignment="Center" Text="{Binding KeyCountText}" />
            <TextBlock Grid.Row="2" Text="値" Style="{StaticResource RowLabelStyle}" />
            <Slider Grid.Row="2" Grid.Column="1" Margin="0,0,8,0" VerticalAlignment="Center" Minimum="0" Maximum="1"
                    SmallChange="0.01" LargeChange="0.1" Value="{Binding MorphWeight}" IsEnabled="{Binding IsEditable}" />
            <c:NumberBox Grid.Row="2" Grid.Column="2" Value="{Binding MorphWeight}" Step="0.01" Format="0.000" />
          </Grid>
          <TextBlock Margin="0,8,0,0" Style="{StaticResource PlannedNoteStyle}"
                     Text="モデルの表情をまとめて動かすには「モーフ」パネルが便利です（表示メニューから出せます）。" />
        </StackPanel>

        <!-- 読み込んだモデル -->
        <StackPanel Visibility="{Binding IsModel, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="モデルの中身" Style="{StaticResource SectionHeaderStyle}" Margin="0,14,0,6" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="96" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="22" />
              <RowDefinition Height="22" />
              <RowDefinition Height="22" />
              <RowDefinition Height="22" />
              <RowDefinition Height="22" />
              <RowDefinition Height="22" />
              <RowDefinition Height="22" />
            </Grid.RowDefinitions>
            <TextBlock Text="形式" Style="{StaticResource RowLabelStyle}" />
            <TextBlock Grid.Column="1" Margin="0,2" Text="{Binding Model.Summary.Format}" />
            <TextBlock Grid.Row="1" Text="ファイル" Style="{StaticResource RowLabelStyle}" VerticalAlignment="Top" Margin="0,3,6,0" />
            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,2" IsReadOnly="True" TextWrapping="Wrap" MinHeight="0" Padding="4,2"
                     FontSize="11" Text="{Binding Model.FilePath, Mode=OneWay}" />
            <TextBlock Grid.Row="2" Text="頂点 / 面" Style="{StaticResource RowLabelStyle}" />
            <TextBlock Grid.Row="2" Grid.Column="1" VerticalAlignment="Center">
              <Run Text="{Binding Model.Summary.Vertices, StringFormat={}{0:N0}, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding Model.Summary.Faces, StringFormat={}{0:N0}, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Grid.Row="3" Text="材質" Style="{StaticResource RowLabelStyle}" />
            <TextBlock Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" Text="{Binding Model.Summary.Materials, StringFormat={}{0:N0}}" />
            <TextBlock Grid.Row="4" Text="テクスチャ" Style="{StaticResource RowLabelStyle}" />
            <TextBlock Grid.Row="4" Grid.Column="1" VerticalAlignment="Center" Text="{Binding Model.Summary.Textures, StringFormat={}{0:N0}}" />
            <TextBlock Grid.Row="5" Text="ボーン" Style="{StaticResource RowLabelStyle}" />
            <TextBlock Grid.Row="5" Grid.Column="1" VerticalAlignment="Center" Text="{Binding Model.Summary.Bones, StringFormat={}{0:N0}}" />
            <TextBlock Grid.Row="6" Text="モーフ" Style="{StaticResource RowLabelStyle}" />
            <TextBlock Grid.Row="6" Grid.Column="1" VerticalAlignment="Center" Text="{Binding Model.Summary.Morphs, StringFormat={}{0:N0}}" />
            <TextBlock Grid.Row="7" Text="剛体" Style="{StaticResource RowLabelStyle}" />
            <TextBlock Grid.Row="7" Grid.Column="1" VerticalAlignment="Center" Text="{Binding Model.Summary.RigidBodies, StringFormat={}{0:N0}}" />
            <TextBlock Grid.Row="8" Text="ジョイント" Style="{StaticResource RowLabelStyle}" />
            <TextBlock Grid.Row="8" Grid.Column="1" VerticalAlignment="Center" Text="{Binding Model.Summary.Joints, StringFormat={}{0:N0}}" />
          </Grid>
          <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
            <Button Content="読み込みレポートを見る" Click="OnShowReportClick" />
            <Button Margin="8,0,0,0" Content="ポーズを初期化" Click="OnResetPoseClick" IsEnabled="{Binding IsEditable}"
                    ToolTip="すべてのボーンを初期の姿勢に、モーフを 0 に戻します（ロックした項目は変えません）" />
            <Button Margin="8,0,0,0" Content="材質..." Click="OnMaterialsClick"
                    ToolTip="材質を PBR（金属らしさ・粗さ）や発光で上書きします（モデルのメニューの「材質の設定」と同じ）" />
          </StackPanel>
          <StackPanel Visibility="{Binding HasModelComment, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="モデルのコメント（作者・利用条件など）" Style="{StaticResource SectionHeaderStyle}" Margin="0,12,0,4" />
            <TextBox IsReadOnly="True" TextWrapping="Wrap" MinHeight="0" MaxHeight="160" Padding="6,4" FontSize="11"
                     VerticalScrollBarVisibility="Auto" Text="{Binding Model.Comment, Mode=OneWay}" />
          </StackPanel>
          <TextBlock Margin="0,8,0,0" Style="{StaticResource PlannedNoteStyle}"
                     Text="MMD と同じトゥーン描画で、輪郭線と影も描きます（影・映像効果はレンダリングのメニュー）。選んだモデルにはボーンを線で重ねて表示します（書き出しには映りません）。髪などの揺れは物理演算（モデルメニュー・ツールバーの「物理」）で計算します。" />
        </StackPanel>

        <!-- カメラ -->
        <StackPanel Visibility="{Binding IsCamera, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="カメラ" Style="{StaticResource SectionHeaderStyle}" Margin="0,14,0,6" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="96" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="84" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="30" />
              <RowDefinition Height="28" />
              <RowDefinition Height="28" />
              <RowDefinition Height="28" />
              <RowDefinition Height="22" />
            </Grid.RowDefinitions>
            <TextBlock Text="視野角 (FOV)" Style="{StaticResource RowLabelStyle}" />
            <Slider Grid.Column="1" Margin="0,0,8,0" VerticalAlignment="Center" Minimum="1" Maximum="170"
                    Value="{Binding FieldOfView}" IsEnabled="{Binding IsEditable}" />
            <c:NumberBox Grid.Column="2" Value="{Binding FieldOfView}" Step="1" Format="0.0°" />
            <TextBlock Grid.Row="1" Text="クリップ（近）" Style="{StaticResource RowLabelStyle}" />
            <c:NumberBox Grid.Row="1" Grid.Column="2" Value="{Binding NearClip}" Step="0.01" />
            <TextBlock Grid.Row="2" Text="クリップ（遠）" Style="{StaticResource RowLabelStyle}" />
            <c:NumberBox Grid.Row="2" Grid.Column="2" Value="{Binding FarClip}" Step="10" Format="0.0" />
            <TextBlock Grid.Row="3" Text="注視点までの距離" Style="{StaticResource RowLabelStyle}"
                       ToolTip="キーを登録するときの注視点（カメラの位置から見ている向きにこの距離だけ進んだ所）。MMD のカメラの「距離」にあたります" />
            <c:NumberBox Grid.Row="3" Grid.Column="2" Value="{Binding TargetDistance}" Step="1" Format="0.00" />
            <TextBlock Grid.Row="4" Text="キー" Style="{StaticResource RowLabelStyle}" />
            <TextBlock Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" VerticalAlignment="Center" Text="{Binding KeyCountText}" />
          </Grid>
          <TextBlock Margin="0,6,0,0" Style="{StaticResource PlannedNoteStyle}"
                     Text="被写界深度（ピントの前後のぼけ）・ブルーム・色調補正・周辺減光は、レンダリングのメニューの「映像効果」、線画・塗りなどは「イラスト風」で設定します。被写界深度は初期値で注視点にピントを合わせ、カメラ視点の区画と書き出しにかかります。" />
        </StackPanel>

        <!-- 音声 -->
        <StackPanel Visibility="{Binding IsAudio, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="音声" Style="{StaticResource SectionHeaderStyle}" Margin="0,14,0,6" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="96" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="84" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="26" />
              <RowDefinition Height="28" />
              <RowDefinition Height="30" />
            </Grid.RowDefinitions>
            <TextBlock Text="ファイル" Style="{StaticResource RowLabelStyle}" VerticalAlignment="Top" Margin="0,3,0,0" />
            <TextBlock Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding AudioFile}" TextWrapping="Wrap" Margin="0,3,0,3"
                       ToolTip="{Binding AudioFile}" />
            <TextBlock Grid.Row="1" Text="長さ" Style="{StaticResource RowLabelStyle}" />
            <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" VerticalAlignment="Center" Text="{Binding AudioLengthText}" />
            <TextBlock Grid.Row="2" Text="鳴り始め" Style="{StaticResource RowLabelStyle}"
                       ToolTip="音声が鳴り始めるフレーム。負の数にすると、音声の頭を飛ばして 0 フレーム目から途中を鳴らします" />
            <c:NumberBox Grid.Row="2" Grid.Column="2" Value="{Binding AudioStartFrame}" Step="1" Format="0" />
            <TextBlock Grid.Row="3" Text="音量" Style="{StaticResource RowLabelStyle}" />
            <Slider Grid.Row="3" Grid.Column="1" Margin="0,0,8,0" VerticalAlignment="Center" Minimum="0" Maximum="100"
                    Value="{Binding AudioVolume}" IsEnabled="{Binding IsEditable}" />
            <c:NumberBox Grid.Row="3" Grid.Column="2" Value="{Binding AudioVolume}" Step="5" Format="0'%'" />
          </Grid>
          <TextBlock Margin="0,6,0,0" Style="{StaticResource PlannedNoteStyle}"
                     Text="再生中は、鳴っている位置に合わせてフレームを進めます。シーン一覧の目の印で音を消せます（タイミングは変わりません）。" />
          <TextBlock Margin="0,4,0,0" Foreground="OrangeRed" TextWrapping="Wrap" Text="{Binding AudioDeviceNote}" />
        </StackPanel>

        <!-- 照明 -->
        <StackPanel Visibility="{Binding IsLight, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="照明" Style="{StaticResource SectionHeaderStyle}" Margin="0,14,0,6" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="96" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="84" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="種類" Style="{StaticResource RowLabelStyle}" />
            <TextBlock Grid.Column="1" Grid.ColumnSpan="2" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding LightTypeText}" />
            <TextBlock Grid.Row="1" Text="色" Style="{StaticResource RowLabelStyle}" ToolTip="#RRGGBB（白 = #FFFFFF）" />
            <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,2" MinHeight="0" Height="24" Padding="4,1"
                     VerticalContentAlignment="Center" IsEnabled="{Binding IsEditable}"
                     Text="{Binding LightColor, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="照明の色" />
            <TextBlock Grid.Row="2" Text="明るさ" Style="{StaticResource RowLabelStyle}" />
            <c:NumberBox Grid.Row="2" Grid.Column="2" Value="{Binding Intensity}" Step="0.1" Format="0.00" />
            <TextBlock Grid.Row="3" Text="届く距離" Style="{StaticResource RowLabelStyle}"
                       Visibility="{Binding IsRangedLight, Converter={StaticResource BoolToVisibility}}"
                       ToolTip="光が届く距離。照明から離れるほど弱くなり、この距離で 0 になります" />
            <c:NumberBox Grid.Row="3" Grid.Column="2" Value="{Binding LightRange}" Step="1" Format="0.0"
                         Visibility="{Binding IsRangedLight, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Grid.Row="4" Text="広がり（度）" Style="{StaticResource RowLabelStyle}"
                       Visibility="{Binding IsSpotLight, Converter={StaticResource BoolToVisibility}}" ToolTip="円すいの全体の角度" />
            <c:NumberBox Grid.Row="4" Grid.Column="2" Value="{Binding SpotAngle}" Step="1" Format="0.0"
                         Visibility="{Binding IsSpotLight, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Grid.Row="5" Text="縁のぼかし" Style="{StaticResource RowLabelStyle}"
                       Visibility="{Binding IsSpotLight, Converter={StaticResource BoolToVisibility}}" ToolTip="0 でくっきり、1 でなめらか" />
            <c:NumberBox Grid.Row="5" Grid.Column="2" Value="{Binding SpotSoftness}" Step="0.05" Format="0.00"
                         Visibility="{Binding IsSpotLight, Converter={StaticResource BoolToVisibility}}" />
          </Grid>
          <CheckBox Margin="0,6,0,0" Content="影を落とす（影をレイトレーシングで求めるとき）" IsChecked="{Binding LightCastsShadow}"
                    IsEnabled="{Binding IsEditable}" Visibility="{Binding IsAddedLight, Converter={StaticResource BoolToVisibility}}"
                    ToolTip="「影の設定...」でセルフシャドウを使い、「影をレイトレーシングで求める」にしたとき、この照明もモデルに影を落とします（くっきりした影。照明ごとに少し重くなります）" />
          <TextBlock Margin="0,6,0,0" Style="{StaticResource PlannedNoteStyle}"
                     Text="MMD の照明は、向き（回転）・色・明るさで、モデルの陰影と影を描きます（隠すと、材質の環境色だけ）。足した照明（シーンのメニュー「照明を追加」）は、位置・向きと色でモデルを明るくします（影は、影をレイトレーシングで求めるときだけ落とします。プレビューに目印の線が出ます）。" />
        </StackPanel>

        <!-- 確認用の立方体 -->
        <StackPanel Visibility="{Binding IsTestObject, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="確認用の設定" Style="{StaticResource SectionHeaderStyle}" Margin="0,14,0,6" />
          <CheckBox Content="再生位置に合わせて回す（タイムラインとの同期の確認用）" IsChecked="{Binding SpinWithFrame}"
                    IsEnabled="{Binding IsEditable}" />
          <TextBlock Margin="0,6,0,0" Style="{StaticResource PlannedNoteStyle}"
                     Text="モデル（PMX）の読み込みは Phase 2 で対応します。それまではこの立方体で表示と操作を確かめます。" />
        </StackPanel>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
