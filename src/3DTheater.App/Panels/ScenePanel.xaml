<UserControl x:Class="Theater3D.App.Panels.ScenePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Theater3D.App.Panels"
             Background="{StaticResource PanelBrush}">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <!-- 目（表示）と鍵（ロック）の小さな切り替えボタン -->
    <Style x:Key="RowToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource IconToggleButtonStyle}">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="20" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Root" Background="Transparent" CornerRadius="3">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{StaticResource HoverBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ExpanderToggleStyle" TargetType="ToggleButton">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Width" Value="16" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border Background="Transparent">
              <TextBlock x:Name="Glyph" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="9"
                         FontFamily="{StaticResource IconFont}" Foreground="{StaticResource SubTextBrush}" Text="&#xE76C;" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Glyph" Property="Text" Value="&#xE70D;" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 複数選択のため TreeView 自身の選択は使わず、行の選択は SceneTreeItem.IsSelected で表す -->
    <Style x:Key="SceneItemStyle" TargetType="TreeViewItem">
      <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="Visibility" Value="{Binding IsShownByFilter, Converter={StaticResource BoolToVisibility}}" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TreeViewItem">
            <StackPanel>
              <Border x:Name="Row" Height="24" Padding="2,0" Background="Transparent" CornerRadius="3">
                <DockPanel>
                  <ToggleButton x:Name="Expander" DockPanel.Dock="Left" Style="{StaticResource ExpanderToggleStyle}"
                                IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" />
                  <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                </DockPanel>
              </Border>
              <ItemsPresenter x:Name="ItemsHost" Margin="14,0,0,0" />
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="HasItems" Value="False">
                <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
              </Trigger>
              <Trigger Property="IsExpanded" Value="False">
                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
              </Trigger>
              <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                <Setter TargetName="Row" Property="Background" Value="{StaticResource HoverBrush}" />
              </Trigger>
              <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter TargetName="Row" Property="Background" Value="{StaticResource SelectionBrush}" />
              </DataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <HierarchicalDataTemplate x:Key="SceneItemTemplate" DataType="{x:Type local:SceneTreeItem}" ItemsSource="{Binding Children}">
      <DockPanel LastChildFill="True">
        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource RowToggleStyle}" IsChecked="{Binding IsLocked}" ToolTip="編集ロック">
          <TextBlock>
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Text" Value="&#xE785;" />
                <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsLocked}" Value="True">
                    <Setter Property="Text" Value="&#xE72E;" />
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </ToggleButton>
        <ToggleButton DockPanel.Dock="Right" IsChecked="{Binding IsVisible}" ToolTip="表示 / 非表示">
          <ToggleButton.Style>
            <!-- 見た目の無い項目（モーフ）では隠す。行の幅はそろえたままにする -->
            <Style TargetType="ToggleButton" BasedOn="{StaticResource RowToggleStyle}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding CanToggleVisibility}" Value="False">
                  <Setter Property="Visibility" Value="Hidden" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </ToggleButton.Style>
          <TextBlock>
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Text" Value="&#xE7B3;" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsVisible}" Value="False">
                    <Setter Property="Text" Value="&#xED1A;" />
                    <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </ToggleButton>
        <TextBlock DockPanel.Dock="Right" Margin="4,0" VerticalAlignment="Center" FontSize="10.5"
                   Foreground="{StaticResource AccentBrush}" Text="{Binding Detail}" ToolTip="動かしている（初期の姿勢・値から変えている）" />
        <TextBlock DockPanel.Dock="Left" Width="20" VerticalAlignment="Center" FontFamily="{StaticResource IconFont}" FontSize="13"
                   Foreground="{StaticResource SubTextBrush}" Text="{Binding Icon}" />
        <Grid>
          <TextBlock VerticalAlignment="Center" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
          <TextBox x:Name="RenameBox" Margin="0,1" MinHeight="0" Padding="4,0" FontSize="12"
                   Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                   Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVisibility}}"
                   KeyDown="OnRenameKeyDown" LostKeyboardFocus="OnRenameLostFocus" IsVisibleChanged="OnRenameVisibleChanged" />
        </Grid>
      </DockPanel>
    </HierarchicalDataTemplate>
  </UserControl.Resources>

  <DockPanel>
    <Grid DockPanel.Dock="Top" Margin="6,6,6,4">
      <TextBox x:Name="SearchBox" MinHeight="0" Padding="26,3,6,3" FontSize="12" TextChanged="OnSearchChanged" />
      <TextBlock Margin="9,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False"
                 FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{StaticResource SubTextBrush}" Text="&#xE721;" />
      <TextBlock x:Name="SearchHint" Margin="28,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                 Foreground="{StaticResource DisabledTextBrush}" Text="名前で絞り込む" />
    </Grid>
    <TreeView x:Name="Tree" Background="Transparent" BorderThickness="0" Padding="2"
              ItemContainerStyle="{StaticResource SceneItemStyle}" ItemTemplate="{StaticResource SceneItemTemplate}"
              PreviewMouseLeftButtonDown="OnTreeMouseDown" KeyDown="OnTreeKeyDown" Focusable="True"
              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <TreeView.Resources>
        <Style TargetType="TreeViewItem" BasedOn="{StaticResource SceneItemStyle}" />
      </TreeView.Resources>
    </TreeView>
  </DockPanel>
</UserControl>
