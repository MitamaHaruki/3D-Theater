<Window x:Class="Theater3D.App.Plugins.PluginTaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="処理中"
        Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Yu Gothic UI" FontSize="12" UseLayoutRounding="True">
  <!-- プラグインの時間のかかる処理の進み具合（すぐに終わらないときだけ出す） -->
  <StackPanel Margin="18,14,18,16">
    <TextBlock x:Name="TitleText" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
    <TextBlock x:Name="PluginText" Margin="0,2,0,0" Foreground="{StaticResource SubTextBrush}" FontSize="11.5" TextWrapping="Wrap" />
    <ProgressBar x:Name="Progress" Height="8" Margin="0,14,0,0" Minimum="0" Maximum="1" IsIndeterminate="True"
                 AutomationProperties.Name="進み具合" />
    <TextBlock x:Name="MessageText" Margin="0,6,0,0" MinHeight="16" Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap"
               AutomationProperties.AutomationId="MessageText" />
    <Button x:Name="CancelButton" Margin="0,14,0,0" HorizontalAlignment="Right" MinWidth="96" Content="取り消す" IsCancel="True"
            Click="OnCancelClick" />
  </StackPanel>
</Window>
