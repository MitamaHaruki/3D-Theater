<Window x:Class="Theater3D.App.Plugins.PluginsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="プラグインの管理"
        Width="820" Height="560" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Yu Gothic UI" FontSize="12" UseLayoutRounding="True">
  <Window.Resources>
    <Style x:Key="LabelStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource SubTextBrush}" />
      <Setter Property="Margin" Value="0,4,12,4" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style x:Key="ValueStyle" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,4" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </Window.Resources>

  <DockPanel Margin="16,12,16,14">
    <Border x:Name="SafeModeBanner" DockPanel.Dock="Top" Margin="0,0,0,10" Padding="10,6" CornerRadius="3" Background="#33E0A030"
            Visibility="Collapsed">
      <TextBlock TextWrapping="Wrap"
                 Text="安全モードで起動しています。有効なプラグインも始めていません（アプリを普通に起動し直すと始めます）。" />
    </Border>

    <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" LastChildFill="False">
      <Button x:Name="ToggleButton" DockPanel.Dock="Left" MinWidth="110" Content="有効にする" Click="OnToggleClick" IsEnabled="False" />
      <Button x:Name="OpenFolderButton" DockPanel.Dock="Left" MinWidth="110" Margin="8,0,0,0" Content="フォルダーを開く" Click="OnOpenFolderClick"
              IsEnabled="False" ToolTip="選んだプラグインのフォルダーを開きます" />
      <Button DockPanel.Dock="Left" MinWidth="110" Margin="8,0,0,0" Content="プラグインを入れる場所を開く" Click="OnOpenUserFolderClick"
              ToolTip="%APPDATA%\3DTheater\Plugins を開きます。プラグインのフォルダー（plugin.json の入ったもの）をここに置き、アプリを起動し直すと見つけます" />
      <Button DockPanel.Dock="Right" MinWidth="88" Content="閉じる" IsCancel="True" IsDefault="True" Click="OnCloseClick" />
    </DockPanel>

    <TextBlock DockPanel.Dock="Bottom" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{StaticResource SubTextBrush}" FontSize="11.5"
               Text="プラグインの追加・削除・更新は、プラグインのフォルダーを置き換えてアプリを起動し直すと反映します。無効にしたプラグインは、登録したメニュー・パネルがすぐに外れますが、DLL はアプリを起動し直すまで読み込まれたままです。プラグインはアプリと同じプロセスで動くため、信頼できるものだけを有効にしてください。Shift を押しながら起動すると、安全モード（プラグインを始めない）になります。" />

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="260" />
        <ColumnDefinition Width="14" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <ListBox x:Name="PluginList" SelectionChanged="OnSelectionChanged" AutomationProperties.Name="プラグインの一覧">
        <!-- 選んだ行は、アプリのほかの一覧（モーフ・シーン）と同じ色にする（Windows の強調色に任せると、補足の文が読みにくい色になることがある） -->
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <Border x:Name="Row" Background="Transparent" CornerRadius="3" Padding="6,2">
                    <ContentPresenter />
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Row" Property="Background" Value="{StaticResource HoverBrush}" />
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                      <Setter TargetName="Row" Property="Background" Value="{StaticResource SelectionBrush}" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="2,3">
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource SubTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <TextBlock x:Name="EmptyText" Margin="10" TextWrapping="Wrap" Foreground="{StaticResource SubTextBrush}" Visibility="Collapsed"
                 Text="プラグインが見つかりません。「プラグインを入れる場所を開く」のフォルダーに置いて、アプリを起動し直してください。" />

      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
        <Grid x:Name="DetailPanel" Visibility="Hidden">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock x:Name="NameText" Grid.ColumnSpan="2" Margin="0,0,0,6" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Grid.Row="1" Style="{StaticResource LabelStyle}" Text="状態" />
          <TextBlock x:Name="StatusText" Grid.Row="1" Grid.Column="1" Style="{StaticResource ValueStyle}" />
          <TextBlock Grid.Row="2" Style="{StaticResource LabelStyle}" Text="版" />
          <TextBlock x:Name="VersionText" Grid.Row="2" Grid.Column="1" Style="{StaticResource ValueStyle}" />
          <TextBlock Grid.Row="3" Style="{StaticResource LabelStyle}" Text="ID" />
          <TextBlock x:Name="IdText" Grid.Row="3" Grid.Column="1" Style="{StaticResource ValueStyle}" />
          <TextBlock Grid.Row="4" Style="{StaticResource LabelStyle}" Text="作者" />
          <TextBlock x:Name="AuthorText" Grid.Row="4" Grid.Column="1" Style="{StaticResource ValueStyle}" />
          <TextBlock Grid.Row="5" Style="{StaticResource LabelStyle}" Text="説明" />
          <TextBlock x:Name="DescriptionText" Grid.Row="5" Grid.Column="1" Style="{StaticResource ValueStyle}" />
          <TextBlock Grid.Row="6" Style="{StaticResource LabelStyle}" Text="使う機能" />
          <TextBlock x:Name="RequiresText" Grid.Row="6" Grid.Column="1" Style="{StaticResource ValueStyle}" />
          <TextBlock Grid.Row="7" Style="{StaticResource LabelStyle}" Text="場所" />
          <TextBlock x:Name="FolderText" Grid.Row="7" Grid.Column="1" Style="{StaticResource ValueStyle}" />
          <TextBlock Grid.Row="8" Style="{StaticResource LabelStyle}" Text="問題の記録" />
          <TextBox x:Name="ProblemsBox" Grid.Row="8" Grid.Column="1" Margin="0,4" MinHeight="70" MaxHeight="160" IsReadOnly="True"
                   TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="問題の記録" />
        </Grid>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</Window>
