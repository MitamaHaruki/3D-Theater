<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>3DTheater</AssemblyName>
    <RootNamespace>Theater3D.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Win32 の呼び出し（LibraryImport）が生成するコードに必要 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- 日本語の画面に必要な分だけ残し、AvalonDock の他言語の資源を出力に入れない -->
    <SatelliteResourceLanguages>ja</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dirkster.AvalonDock" Version="4.74.1" />
    <PackageReference Include="Dirkster.AvalonDock.Themes.VS2013" Version="4.74.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\3DTheater.Animation\3DTheater.Animation.csproj" />
    <ProjectReference Include="..\3DTheater.Domain\3DTheater.Domain.csproj" />
    <ProjectReference Include="..\3DTheater.Editor\3DTheater.Editor.csproj" />
    <ProjectReference Include="..\3DTheater.Formats\3DTheater.Formats.csproj" />
    <ProjectReference Include="..\3DTheater.Engine.Interop\3DTheater.Engine.Interop.csproj" />
    <ProjectReference Include="..\3DTheater.Physics\3DTheater.Physics.csproj" />
    <ProjectReference Include="..\3DTheater.Media\3DTheater.Media.csproj" />
    <ProjectReference Include="..\Plugin.Core\Plugin.Core.csproj" />
    <ProjectReference Include="..\Plugin.UI.Wpf\Plugin.UI.Wpf.csproj" />
    <ProjectReference Include="..\3DTheater.Plugin.SDK\3DTheater.Plugin.SDK.csproj" />
    <!-- サンプルのプラグイン: 先に作り、出力の Plugins\SceneInfo に置く（アプリからは参照しない） -->
    <ProjectReference Include="..\..\plugins\3DTheater.SamplePlugin\3DTheater.SamplePlugin.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopySamplePlugin" AfterTargets="Build">
    <PropertyGroup>
      <SamplePluginOutput>$(MSBuildThisFileDirectory)..\..\plugins\3DTheater.SamplePlugin\bin\$(Platform)\$(Configuration)\net10.0-windows\</SamplePluginOutput>
    </PropertyGroup>
    <ItemGroup>
      <SamplePluginFiles Include="$(SamplePluginOutput)3DTheater.SamplePlugin.dll;$(SamplePluginOutput)3DTheater.SamplePlugin.deps.json;$(MSBuildThisFileDirectory)..\..\plugins\3DTheater.SamplePlugin\plugin.json" />
    </ItemGroup>
    <Copy SourceFiles="@(SamplePluginFiles)" DestinationFolder="$(OutDir)Plugins\SceneInfo\" SkipUnchangedFiles="true" />
  </Target>

</Project>
