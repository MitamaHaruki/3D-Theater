<Window x:Class="Theater3D.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="3D Theater"
        Width="1280" Height="760" MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Yu Gothic UI" FontSize="12"
        UseLayoutRounding="True">
  <Window.Resources>
    <Style x:Key="OverlayLabelStyle" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource OverlayBrush}" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="Margin" Value="10" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
  </Window.Resources>

  <!-- Phase 0 の検証用の画面。タイトルバーへのメニュー統合とドッキングは Phase 1 で作る -->
  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="ファイル(_F)">
        <MenuItem Header="終了(_X)" InputGestureText="Alt+F4" Click="OnExitClick" />
      </MenuItem>
      <MenuItem Header="表示(_V)">
        <MenuItem x:Name="AnimationMenuItem" Header="立方体を回転させる(_A)" IsCheckable="True" IsChecked="True" Click="OnAnimationClick" />
      </MenuItem>
      <MenuItem Header="ヘルプ(_H)">
        <MenuItem Header="ログフォルダーを開く(_L)" Click="OnOpenLogFolderClick" />
        <Separator />
        <MenuItem Header="バージョン情報(_A)" Click="OnAboutClick" />
      </MenuItem>
    </Menu>

    <Border DockPanel.Dock="Bottom" Background="{StaticResource StatusBarBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,1,0,0" Padding="10,4">
      <DockPanel>
        <TextBlock x:Name="FrameRateText" DockPanel.Dock="Right" Foreground="{StaticResource SubTextBrush}" Margin="16,0,0,0" />
        <TextBlock x:Name="VideoMemoryText" DockPanel.Dock="Right" Foreground="{StaticResource SubTextBrush}" Margin="16,0,0,0" />
        <TextBlock x:Name="StatusText" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>

    <Grid Margin="6">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="6" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- 方式 A -->
      <Border Grid.Column="0" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1">
        <DockPanel>
          <Border DockPanel.Dock="Top" Background="{StaticResource PanelHeaderBrush}" Padding="8,5">
            <DockPanel>
              <TextBlock x:Name="HwndTimeText" DockPanel.Dock="Right" Foreground="{StaticResource SubTextBrush}" />
              <TextBlock Text="方式 A: HwndHost（子ウィンドウに直接描画）" FontWeight="SemiBold" />
            </DockPanel>
          </Border>
          <Grid>
            <Border x:Name="HwndHostSlot" />
            <Border Style="{StaticResource OverlayLabelStyle}">
              <TextBlock Text="WPF の文字を 3D の上に重ねる試験" />
            </Border>
          </Grid>
        </DockPanel>
      </Border>

      <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" />

      <!-- 方式 B -->
      <Border Grid.Column="2" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1">
        <DockPanel>
          <Border DockPanel.Dock="Top" Background="{StaticResource PanelHeaderBrush}" Padding="8,5">
            <DockPanel>
              <TextBlock x:Name="D3DImageTimeText" DockPanel.Dock="Right" Foreground="{StaticResource SubTextBrush}" />
              <TextBlock Text="方式 B: D3DImage（共有テクスチャ経由）" FontWeight="SemiBold" />
            </DockPanel>
          </Border>
          <Grid>
            <Border x:Name="D3DImageSlot" />
            <Border Style="{StaticResource OverlayLabelStyle}">
              <TextBlock Text="WPF の文字を 3D の上に重ねる試験" />
            </Border>
          </Grid>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
