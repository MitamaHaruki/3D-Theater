<Window x:Class="Theater3D.App.Import.LoadReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="読み込みレポート"
        Width="760" Height="500" MinWidth="480" MinHeight="300"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Yu Gothic UI" FontSize="12" UseLayoutRounding="True">
  <DockPanel Margin="16,14">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock x:Name="HeadlineText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
      <TextBlock x:Name="PathText" Margin="0,4,0,0" Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap" />
      <TextBlock x:Name="SummaryText" Margin="0,6,0,0" Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap" />
    </StackPanel>

    <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" LastChildFill="False">
      <TextBlock DockPanel.Dock="Left" MaxWidth="460" VerticalAlignment="Center" Style="{StaticResource PlannedNoteStyle}"
                 Text="読み込めたことと、MMD と同じ見た目・動きになることは別に確かめます。今の表示は簡単な陰影です（トゥーンなどは Phase 4）。物理演算の揺れ方も、MMD とまだ見比べていません。" />
      <Button DockPanel.Dock="Right" MinWidth="88" Margin="8,0,0,0" Content="閉じる" IsDefault="True" IsCancel="True" Click="OnCloseClick" />
      <Button DockPanel.Dock="Right" MinWidth="88" Content="内容をコピー" Click="OnCopyClick" />
    </DockPanel>

    <Border Margin="0,12,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Background="{StaticResource BackgroundBrush}">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl x:Name="IssueList" Margin="0,4">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="10,5">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="52" />
                  <ColumnDefinition Width="128" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock FontWeight="SemiBold" Text="{Binding SeverityText}">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Foreground" Value="{StaticResource SubTextBrush}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Severity}" Value="Warning">
                          <Setter Property="Foreground" Value="#FFE0A040" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Severity}" Value="Error">
                          <Setter Property="Foreground" Value="#FFF05050" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
                <TextBlock Grid.Column="1" Foreground="{StaticResource SubTextBrush}" Text="{Binding CategoryText}" />
                <TextBlock Grid.Column="2" TextWrapping="Wrap" Text="{Binding Message}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>
  </DockPanel>
</Window>
