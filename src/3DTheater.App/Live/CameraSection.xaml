<UserControl x:Class="Theater3D.App.Live.CameraSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- サイドバーの「カメラ」（設計判断記録 78 章の 3 段目）: 「ライブカメラ」（初めからある・消せない）と、別の視点のカメラを足す・外す・名前を変える -->
  <StackPanel>
    <DockPanel>
      <Button DockPanel.Dock="Right" Style="{StaticResource LiveActionButtonStyle}" Margin="8,0,0,0" Content="カメラを足す" Click="OnAddClick"
              AutomationProperties.Name="カメラを足す" ToolTip="今見ているカメラと同じ所に、別の視点のカメラを足して、プレビューをそのカメラにします" />
      <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource SubTextBrush}"
                 Text="見るカメラと配信するカメラは、右の「カメラ情報」で切り替えます" />
    </DockPanel>
    <ListBox x:Name="ItemList" Margin="0,8,0,0" MaxHeight="200" Background="Transparent" AutomationProperties.Name="カメラの一覧"
             SelectionChanged="OnListSelectionChanged" />
    <StackPanel x:Name="Body" Margin="0,10,0,0">
      <DockPanel>
        <Button x:Name="RenameButton" DockPanel.Dock="Right" Style="{StaticResource LiveActionButtonStyle}" Margin="8,0,0,0" Content="名前を変える"
                Click="OnRenameClick" AutomationProperties.Name="カメラの名前を変える" />
        <TextBox x:Name="NameBox" MinHeight="0" Padding="6,3" VerticalAlignment="Center" AutomationProperties.Name="カメラの名前" KeyDown="OnNameKeyDown" />
      </DockPanel>
      <WrapPanel Margin="0,8,0,0">
        <Button x:Name="ViewButton" Style="{StaticResource LiveActionButtonStyle}" Content="このカメラで見る" Click="OnViewClick"
                AutomationProperties.Name="このカメラで見る" ToolTip="プレビューに、このカメラから見た絵を映します（配信は変わりません）" />
        <Button x:Name="RemoveButton" Style="{StaticResource LiveActionButtonStyle}" Content="外す" Click="OnRemoveClick" AutomationProperties.Name="カメラを外す"
                ToolTip="このカメラをシーンから外します（Ctrl+Z で戻せます）。見ていた・配信していたときは、ライブカメラに戻ります" />
      </WrapPanel>
      <TextBlock x:Name="LiveNote" Margin="0,2,0,0" Style="{StaticResource PlannedNoteStyle}"
                 Text="ライブカメラは初めからあるカメラで、外したり名前を変えたりはできません（位置・向き・視野角は変えられます）。" />
    </StackPanel>
  </StackPanel>
</UserControl>
