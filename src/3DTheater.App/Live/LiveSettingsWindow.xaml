<Window x:Class="Theater3D.App.Live.LiveSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="設定 - 3D Theater"
        Width="960" Height="680" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Yu Gothic UI" FontSize="12"
        UseLayoutRounding="True">
  <!-- ライブモードの設定画面（設計判断記録 78 章）: 左の一覧で選んだ項目の中身を、右に出す。開いたまま、プレビューを見ながら変えられる -->
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="220" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
      <ListBox x:Name="PageList" Margin="8" Background="Transparent" BorderThickness="0" FontSize="13"
               AutomationProperties.Name="設定の項目" SelectionChanged="OnPageChanged" />
    </Border>
    <DockPanel Grid.Column="1" Margin="24,18,12,12">
      <TextBlock x:Name="PageTitle" DockPanel.Dock="Top" Margin="0,0,0,14" FontSize="18" FontWeight="SemiBold"
                 AutomationProperties.AutomationId="SettingsPageTitle" />
      <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0">
        <ContentControl x:Name="PageHost" Focusable="False" />
      </ScrollViewer>
    </DockPanel>
  </Grid>
</Window>
