<Window x:Class="Theater3D.App.Live.PhoneConnectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="スマホから受け取る"
        Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Yu Gothic UI" FontSize="12"
        UseLayoutRounding="True">
  <!-- スマホを選んだときに出す（設計判断記録 78 章の 5 段目）: IP・案内・向きを逆にする・接続 -->
  <StackPanel Margin="20,16,20,16">
    <TextBlock x:Name="KindText" FontWeight="SemiBold" TextWrapping="Wrap" />
    <TextBlock x:Name="HelpText" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource SubTextBrush}" AutomationProperties.AutomationId="PhoneHelp" />
    <DockPanel x:Name="AddressRow" Margin="0,12,0,0">
      <TextBlock DockPanel.Dock="Left" Width="90" VerticalAlignment="Center" Text="スマホの IP" />
      <TextBox x:Name="AddressBox" MinHeight="0" Padding="6,3" AutomationProperties.Name="スマホの IP" TextChanged="OnAddressChanged"
               ToolTip="スマホのアプリに出ている IP（例: 192.168.1.20）" />
    </DockPanel>
    <TextBlock x:Name="ProblemText" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{StaticResource LiveErrorBrush}" AutomationProperties.AutomationId="PhoneProblem" />
    <TextBlock Margin="0,10,0,4" Text="キャラクターが思った向きと逆に動くときは、入れてください" Foreground="{StaticResource SubTextBrush}" />
    <WrapPanel>
      <CheckBox x:Name="InvertYawCheck" Content="左右を逆に" AutomationProperties.Name="スマホの左右を逆にする" />
      <CheckBox x:Name="InvertPitchCheck" Margin="16,0,0,0" Content="上下を逆に" AutomationProperties.Name="スマホの上下を逆にする" />
      <CheckBox x:Name="InvertRollCheck" Margin="16,0,0,0" Content="傾きを逆に" AutomationProperties.Name="スマホの傾きを逆にする" />
    </WrapPanel>
    <StackPanel Margin="0,18,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="ConnectButton" MinWidth="88" Content="接続" IsDefault="True" Click="OnConnectClick" AutomationProperties.Name="スマホに接続" />
      <Button Margin="8,0,0,0" MinWidth="88" Content="キャンセル" IsCancel="True" AutomationProperties.Name="キャンセル" />
    </StackPanel>
  </StackPanel>
</Window>
