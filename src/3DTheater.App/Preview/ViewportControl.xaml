<UserControl x:Class="Theater3D.App.Preview.ViewportControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Theater3D.App.Preview"
             Focusable="True"
             FocusVisualStyle="{x:Null}">
  <Border x:Name="Frame" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
    <Grid ClipToBounds="True">
      <Border x:Name="SurfaceHost" />

      <!-- カメラ視点: 書き出しの枠（枠の外を暗くし、枠の線を引く。マウスは下の 3D へ通す） -->
      <Path x:Name="ExportFrameShade" IsHitTestVisible="False" Fill="#80000000" Visibility="Collapsed" />
      <Rectangle x:Name="ExportFrameLine" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top"
                 Stroke="#C0FFFFFF" StrokeThickness="1" Visibility="Collapsed" />

      <local:AxisIndicator x:Name="Axes" Width="62" Height="62" Margin="4" HorizontalAlignment="Left" VerticalAlignment="Bottom" />

      <!-- 3D の上に重ねる見出し（方式 B なので WPF の部品をそのまま重ねられる） -->
      <DockPanel x:Name="HeaderBar" Margin="6" VerticalAlignment="Top" LastChildFill="False">
        <Button x:Name="ViewMenuButton" DockPanel.Dock="Left" Style="{StaticResource ViewportHeaderButtonStyle}"
                Click="OnViewMenuClick" ToolTip="視点を切り替える">
          <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="ViewNameText" VerticalAlignment="Center" />
            <TextBlock Margin="6,1,0,0" VerticalAlignment="Center" FontFamily="{StaticResource IconFont}" FontSize="9" Text="&#xE70D;" />
          </StackPanel>
        </Button>
        <TextBlock x:Name="ProjectionText" DockPanel.Dock="Left" Margin="8,0,0,0" VerticalAlignment="Center"
                   FontSize="11" Foreground="{StaticResource SubTextBrush}" />
        <Button x:Name="MaximizeButton" DockPanel.Dock="Right" Style="{StaticResource ViewportIconButtonStyle}"
                Click="OnMaximizeClick" Content="&#xE740;" ToolTip="この区画だけを大きく表示する" />
      </DockPanel>
    </Grid>
  </Border>
</UserControl>
