<UserControl x:Class="Theater3D.App.Preview.PreviewPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">
  <DockPanel>
    <!-- このプレビューの分け方 -->
    <Border DockPanel.Dock="Top" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="4,2">
      <StackPanel Orientation="Horizontal">
        <ToggleButton x:Name="SingleButton" Style="{StaticResource IconToggleButtonStyle}" Click="OnLayoutClick" Tag="Single" ToolTip="1 画面">
          <Rectangle Width="13" Height="11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.2" />
        </ToggleButton>
        <ToggleButton x:Name="SideBySideButton" Style="{StaticResource IconToggleButtonStyle}" Click="OnLayoutClick" Tag="SideBySide" ToolTip="2 画面（左右）">
          <Grid Width="13" Height="11">
            <Rectangle Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.2" />
            <Rectangle Width="1.2" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
          </Grid>
        </ToggleButton>
        <ToggleButton x:Name="QuadButton" Style="{StaticResource IconToggleButtonStyle}" Click="OnLayoutClick" Tag="Quad" ToolTip="4 画面">
          <Grid Width="13" Height="11">
            <Rectangle Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.2" />
            <Rectangle Width="1.2" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
            <Rectangle Height="1.2" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
          </Grid>
        </ToggleButton>
        <ComboBox x:Name="PresetCombo" Width="220" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12"
                  MinHeight="0" Padding="8,2" SelectionChanged="OnPresetChanged" ToolTip="4 画面の視点の組み合わせ" />
        <Rectangle Style="{StaticResource ToolbarSeparatorStyle}" />
        <ToggleButton x:Name="GridButton" Style="{StaticResource IconToggleButtonStyle}" Click="OnGridClick" IsChecked="True" ToolTip="グリッドを表示">
          <Path Width="13" Height="13" Stretch="Fill" StrokeThickness="1.1"
                Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                Data="M0,4 H12 M0,8 H12 M4,0 V12 M8,0 V12" />
        </ToggleButton>
      </StackPanel>
    </Border>

    <Grid x:Name="ViewGrid" Margin="2">
      <Grid.RowDefinitions>
        <RowDefinition />
        <RowDefinition />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition />
        <ColumnDefinition />
      </Grid.ColumnDefinitions>
    </Grid>
  </DockPanel>
</UserControl>
