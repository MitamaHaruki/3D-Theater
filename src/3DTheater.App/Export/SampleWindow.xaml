<Window x:Class="Theater3D.App.Export.SampleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="書き出しの見本"
        Width="820" Height="560" MinWidth="360" MinHeight="260"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Yu Gothic UI" FontSize="12" UseLayoutRounding="True">
  <Window.Resources>
    <!-- 透明な所に見せる市松模様 -->
    <DrawingBrush x:Key="CheckerBrush" TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
      <DrawingBrush.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="#FF9A9A9A" Geometry="M0,0 H2 V2 H0 Z" />
          <GeometryDrawing Brush="#FFCFCFCF" Geometry="M0,0 H1 V1 H0 Z M1,1 H2 V2 H1 Z" />
        </DrawingGroup>
      </DrawingBrush.Drawing>
    </DrawingBrush>
  </Window.Resources>

  <DockPanel Margin="14,12,14,14">
    <TextBlock x:Name="InfoText" DockPanel.Dock="Top" Margin="0,0,0,8" TextWrapping="Wrap" Foreground="{StaticResource SubTextBrush}" />
    <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" LastChildFill="False">
      <CheckBox x:Name="ActualSizeCheck" DockPanel.Dock="Left" VerticalAlignment="Center" Content="実際の大きさで見る（1 画素を 1 画素で）"
                Checked="OnScaleChanged" Unchecked="OnScaleChanged" />
      <Button DockPanel.Dock="Right" MinWidth="88" Content="閉じる" IsCancel="True" IsDefault="True" Click="OnCloseClick" />
    </DockPanel>
    <Border BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
      <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled">
        <Grid x:Name="ImageArea" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Rectangle x:Name="Checker" Fill="{StaticResource CheckerBrush}" />
          <Image x:Name="SampleImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
        </Grid>
      </ScrollViewer>
    </Border>
  </DockPanel>
</Window>
