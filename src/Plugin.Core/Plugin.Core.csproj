<Project Sdk="Microsoft.NET.Sdk">

  <!-- 共通のプラグインの契約と管理（指示書 7 章）。アプリ（3D Theater・Drawing Canvas）にも WPF にも依存しない。
       この DLL はアプリと全プラグインで 1 つだけ読み込む（プラグインごとの読み込み先からは、アプリのものを使う） -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Plugin.Core</RootNamespace>
    <AssemblyName>Plugin.Core</AssemblyName>
    <Version>1.0.0</Version>
    <!-- プラグインを作る人のための説明（XML の API 文書）。DLL と一緒にアプリの出力へ写り、Visual Studio の候補の説明に出る -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Plugin.Core.Tests" />
  </ItemGroup>

</Project>
