<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Theater3D.Physics</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NativeOutDir>$(RepoRoot)artifacts\native\$(NativePlatform)\$(Configuration)\</NativeOutDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\3DTheater.Animation\3DTheater.Animation.csproj" />
  </ItemGroup>

  <!-- C++ の物理（Bullet を組み込んだ DLL）を先にビルドさせ、できた DLL をこのプロジェクトと参照元の出力へコピーする -->
  <ItemGroup>
    <ProjectReference Include="..\3DTheater.Physics.Native\3DTheater.Physics.Native.vcxproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true"
                      SetPlatform="Platform=$(NativePlatform)"
                      Private="false" />
  </ItemGroup>
  <ItemGroup>
    <None Include="$(NativeOutDir)3DTheater.Physics.Native.dll" Link="3DTheater.Physics.Native.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(NativeOutDir)3DTheater.Physics.Native.pdb" Link="3DTheater.Physics.Native.pdb" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

</Project>
